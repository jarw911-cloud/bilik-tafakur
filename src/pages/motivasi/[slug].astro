---
import MainLayout from '../../layouts/MainLayout.astro';
import { daftarMotivasi } from '../../data/motivasi.js';

export function getStaticPaths() {
    return daftarMotivasi.map((materi) => ({
        params: { slug: materi.slug },
        props: { materi }
    }));
}
const { materi } = Astro.props;
---

<MainLayout title={`${materi.judul} - Bilik Tafakur`}>
    <div class="max-w-4xl mx-auto py-12 px-8 md:px-12 lg:px-16 animate-fade-in">
        <a href="/motivasi" class="text-sm font-bold text-emerald-700 dark:text-emerald-400 mb-8 inline-flex items-center gap-2 hover:translate-x-[-4px] transition-transform">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="3"><path d="m15 18-6-6 6-6"/></svg> DAFTAR ARTIKEL
        </a>

        <article class="bg-white dark:bg-slate-900 rounded-[3rem] border border-slate-200 dark:border-slate-800 shadow-2xl overflow-hidden p-10 md:p-16">
            <div class="text-center md:text-left mb-10">
                <span class="text-5xl mb-6 block">{materi.icon}</span>
                <h1 class="text-4xl md:text-6xl font-poppins font-bold text-slate-900 dark:text-white leading-tight mb-6">{materi.judul}</h1>
                <div class="h-1 w-20 bg-emerald-500 rounded-full mb-6 mx-auto md:mx-0"></div>
                <p class="text-sm text-slate-400 font-bold tracking-widest uppercase">{materi.kategori} • {materi.tanggal}</p>
            </div>

            <div class="mb-12 p-10 bg-emerald-50/50 dark:bg-emerald-900/10 rounded-[2.5rem] border-l-8 border-emerald-500 italic text-xl md:text-2xl text-emerald-900 dark:text-emerald-100 font-jakarta leading-relaxed">
                "{materi.kutipan}"
            </div>

            <div class="prose prose-emerald dark:prose-invert prose-lg max-w-none text-slate-700 dark:text-slate-300 leading-relaxed custom-article" set:html={materi.isiHtml}></div>
        </article>
    </div>
</MainLayout>

<style>
    .animate-fade-in { animation: fadeIn 0.5s ease-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    :global(.custom-article p) { margin-bottom: 2em; }
    :global(.custom-article h3) { font-size: 1.5rem; font-weight: 800; margin-top: 2.5em; margin-bottom: 1em; color: #065f46; }
    :global(.dark .custom-article h3) { color: #34d399; }
    :global(.custom-article ul) { list-style-type: disc; margin-left: 1.5rem; margin-bottom: 2em; }
    :global(.custom-article li) { margin-bottom: 1em; }
</style>