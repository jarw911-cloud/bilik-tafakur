---
import MainLayout from '../layouts/MainLayout.astro';

const jilidIqra = [
    { id: 1, warna: "bg-red-500", teks: "text-red-700", desc: "Pengenalan huruf Hijaiyah dasar tunggal." },
    { id: 2, warna: "bg-orange-500", teks: "text-orange-700", desc: "Pengenalan huruf bersambung dan mad (panjang) dasar." },
    { id: 3, warna: "bg-yellow-500", teks: "text-yellow-700", desc: "Pengenalan harakat Kasrah dan Dhammah." },
    { id: 4, warna: "bg-green-500", teks: "text-green-700", desc: "Pengenalan Tanwin, Sukun (mati), dan Qalqalah." },
    { id: 5, warna: "bg-blue-500", teks: "text-blue-700", desc: "Pengenalan Tasydid, Waqaf, dan bacaan tajwid dasar." },
    { id: 6, warna: "bg-purple-500", teks: "text-purple-700", desc: "Pengenalan tajwid lanjutan, Idgham, Ikhfa, dan bacaan tartil." }
];
---

<MainLayout title="Iqra' Digital">
    <div class="mb-12 text-center md:text-left">
        <h1 class="text-3xl md:text-4xl font-serif font-bold text-slate-900 dark:text-white mb-4">Iqra' Digital</h1>
        <p class="text-slate-600 dark:text-slate-400">Mari belajar membaca Al-Quran dari dasar. Pilih jilid untuk memulai.</p>
        <div class="mt-8 h-px w-full bg-slate-200 dark:bg-slate-800/50"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {jilidIqra.map((iqra) => (
            <a href={`/iqra/${iqra.id}`} class="group relative bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden">
                <div class={`absolute top-0 right-0 w-24 h-24 ${iqra.warna} opacity-10 rounded-bl-full group-hover:scale-125 transition-transform duration-500`}></div>
                
                <div class="relative z-10 flex flex-col h-full">
                    <div class="flex items-center justify-between mb-6">
                        <h2 class="text-3xl font-bold text-slate-800 dark:text-slate-100">
                            Iqra' <span class={iqra.teks}>{iqra.id}</span>
                        </h2>
                        <div class={`w-12 h-12 rounded-full ${iqra.warna} text-white flex items-center justify-center font-bold text-xl shadow-md group-hover:rotate-12 transition-transform`}>
                            {iqra.id}
                        </div>
                    </div>
                    <p class="text-sm text-slate-600 dark:text-slate-400 mb-6 flex-1">
                        {iqra.desc}
                    </p>
                    <div class="flex items-center gap-2 text-sm font-bold text-emerald-600 dark:text-emerald-400 group-hover:translate-x-2 transition-transform">
                        Buka Jilid Ini <span class="text-lg">→</span>
                    </div>
                </div>
            </a>
        ))}
    </div>
</MainLayout>