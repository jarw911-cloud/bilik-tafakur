---
import MainLayout from '../layouts/MainLayout.astro';
import { daftarFikih } from '../data/fikih.js';
---

<MainLayout title="Fikih & Ibadah">
    <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="text-center md:text-left">
            <h1 id="page-title" class="text-3xl md:text-4xl font-poppins font-bold text-emerald-900 dark:text-emerald-400 mb-3 tracking-tight">Fikih & Ibadah</h1>
            <p id="page-desc" class="text-slate-600 dark:text-slate-400 text-sm md:text-base leading-relaxed">
                Panduan ibadah berdasarkan dalil Al-Quran serta Hadits Nabi SAW.
            </p>
        </div>

        <div class="flex justify-center md:justify-end items-center h-12">
            <div id="search-container" class="flex items-center bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-full p-1 transition-all duration-500 w-12 overflow-hidden shadow-sm hover:shadow-md">
                <button id="btn-search-toggle" class="w-10 h-10 flex-shrink-0 flex items-center justify-center text-emerald-600 dark:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-900/30 rounded-full outline-none">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                </button>
                <input type="text" id="input-search-fikih" placeholder="Cari panduan..." class="w-full bg-transparent border-none focus:outline-none text-sm px-3 text-slate-700 dark:text-slate-200 opacity-0 pointer-events-none transition-opacity duration-300 font-jakarta" />
                <button id="btn-search-close" class="hidden w-8 h-8 flex-shrink-0 flex items-center justify-center text-slate-400 hover:text-red-500 rounded-full mr-1 outline-none">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>
        </div>
    </div>

    <div class="space-y-4" id="fikih-list-container">
        {daftarFikih.map((item, index) => (
            <details class="fikih-item group bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 overflow-hidden [&_summary::-webkit-details-marker]:hidden">
                <summary class="flex items-center justify-between cursor-pointer p-4 md:p-5 hover:bg-emerald-50 dark:hover:bg-emerald-900/20 transition-colors">
                    <div class="flex items-center gap-4">
                        <div class="w-2 h-2 rounded-full bg-emerald-400 flex-shrink-0 shadow-sm border border-emerald-200 dark:border-emerald-700"></div>
                        <h2 class="fikih-title font-poppins font-semibold text-slate-800 dark:text-slate-200 text-[15px] md:text-lg group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors">
                            {item.judul}
                        </h2>
                    </div>
                    <div class="text-slate-400 group-open:rotate-180 transition-transform duration-300 flex-shrink-0 ml-4">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    </div>
                </summary>
                
                <div class="p-5 md:p-6 bg-slate-50 dark:bg-slate-950/50 border-t border-slate-100 dark:border-slate-800 space-y-6">
                    
                    <div class="bg-emerald-50/50 dark:bg-emerald-900/10 p-5 rounded-2xl border border-emerald-100 dark:border-emerald-900/30">
                        <span class="text-[10px] uppercase tracking-widest text-emerald-600 dark:text-emerald-500 font-bold mb-2 block">Dasar Hukum:</span>
                        <p class="text-sm md:text-base text-slate-700 dark:text-slate-300 leading-relaxed font-serif italic">
                            "{item.dasar}"
                        </p>
                    </div>

                    <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
                        <span class="text-[10px] uppercase tracking-widest text-emerald-600 dark:text-emerald-500 font-bold mb-3 block">Niat:</span>
                        <p class="font-serif text-right text-2xl md:text-3xl text-emerald-950 dark:text-emerald-50 leading-loose mb-4">{item.niatArab}</p>
                        <p class="text-sm text-slate-700 dark:text-slate-300 italic mb-2">"{item.niatLatin}"</p>
                        <p class="text-sm text-slate-600 dark:text-slate-400"><strong>Artinya:</strong> {item.artiNiat}</p>
                    </div>

                    <div class="space-y-3">
                        <span class="text-[10px] uppercase tracking-widest text-slate-500 dark:text-slate-400 font-bold mb-1 block">Tata Cara Pelaksanaan:</span>
                        <div class="grid grid-cols-1 gap-2">
                            {item.tataCara.map((langkah, i) => (
                                <div class="flex items-start gap-3 p-3 bg-white dark:bg-slate-900 rounded-xl border border-slate-100 dark:border-slate-800">
                                    <span class="w-5 h-5 flex-shrink-0 bg-emerald-100 dark:bg-emerald-900/50 text-emerald-700 dark:text-emerald-400 rounded-full flex items-center justify-center text-[10px] font-bold">{i + 1}</span>
                                    <p class="text-sm text-slate-700 dark:text-slate-300">{langkah}</p>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            </details>
        ))}
    </div>

   <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const globalSearch = document.getElementById('global-search-input'); // Ambil input header
        const items = document.querySelectorAll('.fikih-item');

        if (globalSearch) {
            globalSearch.addEventListener('input', (e) => {
                const term = e.target.value.toLowerCase();
                items.forEach(item => {
                    const title = item.querySelector('.fikih-title').innerText.toLowerCase();
                    // Saring tampilan adhedhasar judul
                    item.style.display = title.includes(term) ? 'block' : 'none';
                });
            });
        }
    });
</script>
</MainLayout>