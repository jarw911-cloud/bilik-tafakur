---
import MainLayout from '../../layouts/MainLayout.astro';

export function getStaticPaths() {
    // Ndamel 6 rute otomatis kagem jilid-1 ngantos jilid-6
    return [1, 2, 3, 4, 5, 6].map((no) => ({
        params: { jilid: `jilid-${no}` },
        props: { no, totalHalaman: 30 } // Asumsi sawetawis saben jilid wonten 30 halaman
    }));
}

const { no, totalHalaman } = Astro.props;
---

<MainLayout title={`Iqra Jilid ${no} - Bilik Tafakur`}>
    <div class="max-w-4xl mx-auto py-8 px-6 md:px-12 lg:px-16 md:py-12 animate-fade-in">
        
        <div class="mb-8">
            <a href="/iqra" class="text-sm font-bold text-emerald-700 dark:text-emerald-400 hover:text-emerald-500 transition-colors flex items-center gap-2 inline-flex">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                KEMBALI KE DAFTAR IQRA
            </a>
        </div>

        <div class="bg-white dark:bg-slate-900 rounded-[2.5rem] border border-slate-200 dark:border-slate-800 shadow-xl p-6 md:p-10 text-center">
            
            <h1 class="text-3xl md:text-4xl font-black text-emerald-900 dark:text-emerald-400 mb-8 tracking-wide">
                IQRA JILID {no}
            </h1>
            
            <div class="aspect-[3/4] max-w-md mx-auto bg-slate-50 dark:bg-slate-950 rounded-2xl border-2 border-dashed border-slate-300 dark:border-slate-700 flex flex-col items-center justify-center mb-8 relative overflow-hidden shadow-inner transition-all" id="kertas-iqra">
                
                <span class="text-6xl mb-4 opacity-50">📖</span>
                
                <p class="text-slate-500 dark:text-slate-400 font-medium px-8 text-lg">
                    Materi Halaman <span id="angka-halaman" class="font-black text-emerald-600 dark:text-emerald-400 text-3xl block mt-2">1</span>
                </p>
                
                <p class="text-xs text-slate-400 mt-10 italic absolute bottom-6 px-4">
                    (Ruang niki kagem masang gambar foto Iqra asline)
                </p>

            </div>

            <div class="flex items-center justify-center gap-4 md:gap-8 bg-slate-50 dark:bg-slate-800/50 p-4 rounded-3xl inline-flex mx-auto border border-slate-100 dark:border-slate-800">
                
                <button id="btn-prev" class="p-3 md:px-6 md:py-3 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-bold rounded-2xl hover:text-emerald-600 transition-all disabled:opacity-30 disabled:cursor-not-allowed border border-slate-200 dark:border-slate-700 shadow-sm flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                    <span class="hidden md:inline">Sebelumnya</span>
                </button>
                
                <div class="text-sm md:text-base font-bold text-slate-500 dark:text-slate-400 min-w-[5rem]">
                    Hal <span id="current-page" class="text-emerald-600 dark:text-emerald-400">1</span> / {totalHalaman}
                </div>

                <button id="btn-next" class="p-3 md:px-6 md:py-3 bg-emerald-600 text-white font-bold rounded-2xl hover:bg-emerald-700 transition-all shadow-lg hover:shadow-emerald-600/30 flex items-center gap-2">
                    <span class="hidden md:inline">Selanjutnya</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                </button>

            </div>
        </div>
    </div>
</MainLayout>

<script is:inline define:vars={{ totalHalaman }}>
    document.addEventListener('DOMContentLoaded', () => {
        let currentPage = 1;
        const btnPrev = document.getElementById('btn-prev');
        const btnNext = document.getElementById('btn-next');
        const labelAngka = document.getElementById('angka-halaman');
        const labelCurrent = document.getElementById('current-page');
        const kertas = document.getElementById('kertas-iqra');

        const updateUI = () => {
            // Ngganti angka
            labelAngka.textContent = currentPage;
            labelCurrent.textContent = currentPage;
            
            // Ngaktifake/Mateni tombol
            btnPrev.disabled = currentPage === 1;
            btnNext.disabled = currentPage === totalHalaman;

            // Efek animasi sethithik pas ganti halaman
            kertas.style.opacity = '0.5';
            setTimeout(() => { kertas.style.opacity = '1'; }, 150);
        };

        if(btnPrev && btnNext) {
            btnPrev.onclick = () => { if (currentPage > 1) { currentPage--; updateUI(); } };
            btnNext.onclick = () => { if (currentPage < totalHalaman) { currentPage++; updateUI(); } };
            updateUI(); // Seting awal
        }
    });
</script>

<style>
    .animate-fade-in { animation: fadeIn 0.4s ease-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>