---
import MainLayout from '../../layouts/MainLayout.astro';
import { daftarDoa } from '../../data/doa.js';

export function getStaticPaths() {
    return daftarDoa.map((materi) => {
        const slugOtomatis = materi.slug || materi.judul.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
        return {
            params: { slug: slugOtomatis },
            props: { materi }
        };
    });
}

const { materi } = Astro.props;

// --- TAMBAHAN KAGEM WHATSAPP SHARE ---
const currentUrl = Astro.url.href; // Narik link halaman otomatis
const pesanWA = encodeURIComponent(`Kunjungi: *${materi.judul}* di Bilik Tafakur.\n\nSemoga bermanfaat: `);
const linkWhatsApp = `https://api.whatsapp.com/send?text=${pesanWA}${currentUrl}`;
// -------------------------------------
---

<MainLayout 
    title={`${materi.judul} - Bilik Tafakur`} 
    description={materi.arti ? materi.arti : "Waos selengkapipun ing Bilik Tafakur."}
>
    <div class="max-w-4xl mx-auto py-8 px-6 md:px-12 lg:px-16 md:py-12 animate-fade-in">
        
        <div class="mb-8">
            <a href="/doa" class="text-sm font-bold text-emerald-700 dark:text-emerald-400 hover:text-emerald-500 transition-colors flex items-center gap-2 inline-flex">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                KEMBALI KE DAFTAR DOA
            </a>
        </div>

        <article class="bg-white dark:bg-slate-900 rounded-[2.5rem] border border-slate-200 dark:border-slate-800 shadow-xl overflow-hidden p-8 md:p-14">
            
            <div class="text-center mb-8 border-b border-slate-200 dark:border-slate-800 pb-8">
                <span class="text-4xl mb-4 block">🤲</span>
                <h1 class="text-3xl md:text-4xl lg:text-5xl font-poppins font-bold text-emerald-900 dark:text-emerald-400 leading-tight">
                    {materi.judul}
                </h1>
            </div>

            {materi.arab && (
                <div class="text-right mb-12 px-2 md:px-8 py-4 overflow-visible">
                    <p dir="rtl" class="font-serif text-[2.25rem] md:text-5xl lg:text-[3.25rem] text-slate-900 dark:text-slate-50" style="line-height: 3.5 !important;">
                        {materi.arab}
                    </p>
                </div>
            )}

            {(materi.latin || materi.arti) && (
                <div class="p-6 md:p-10 bg-emerald-50/50 dark:bg-emerald-900/10 rounded-3xl border border-emerald-100 dark:border-emerald-800/30 mb-12 shadow-inner flex flex-col">
                    {materi.latin && (
                        <p class="text-left text-lg md:text-xl text-emerald-800 dark:text-emerald-300 italic font-medium mb-6 font-jakarta leading-relaxed">
                            "{materi.latin}"
                        </p>
                    )}
                    
                    {materi.latin && materi.arti && <div class="h-px w-16 bg-emerald-200 dark:bg-emerald-800 mx-auto mb-6"></div>}
                    
                    {materi.arti && (
                        <div class="text-center">
                            <span class="font-bold uppercase tracking-widest text-[10px] block mb-2 text-slate-400">Terjemahan:</span> 
                            <p class="text-base md:text-lg text-slate-600 dark:text-slate-400 leading-relaxed font-medium text-slate-700 dark:text-slate-200">
                                {materi.arti}
                            </p>
                        </div>
                    )}
                </div>
            )}

            {materi.narasi && (
                <div class="mt-12 relative border-t border-slate-100 dark:border-slate-800 pt-10">
                    <h3 class="text-xl md:text-2xl font-bold text-emerald-800 dark:text-emerald-400 mb-6 flex items-center gap-3">
                        <span class="text-2xl">💡</span> Makna & Tafakur
                    </h3>
                    <div class="prose prose-lg prose-emerald dark:prose-invert max-w-none text-slate-600 dark:text-slate-300 font-jakarta leading-relaxed" style="white-space: pre-line;">
                        {materi.narasi.split('\n\n').map(paragraph => {
                            const isNalarTeras = paragraph.includes('NALAR TERAS');
                            return (
                                <>
                                    {/* Kodingan riwayat ingkang sampun dirapikake sethithik */}
                                    {isNalarTeras && materi.riwayat && (
                                        <div class="text-center my-10 not-prose">
                                            <p class="text-sm md:text-base font-bold italic text-slate-500 dark:text-slate-400 m-0">
                                                -- {materi.riwayat} --
                                            </p>
                                        </div>
                                    )}
                                    
                                    <p class="mb-4" set:html={paragraph.trim().replace(/\*\*(.*?)\*\*/g, '<strong class="text-emerald-800 dark:text-emerald-400">$1</strong>')}></p>
                                </>
                            )
                        })}
                    </div>
                </div>
            )}

            <div class="mt-16 pt-8 border-t-2 border-dashed border-slate-150 dark:border-slate-700 flex flex-col sm:flex-row items-center justify-between gap-6">
                <div class="text-center sm:text-left">
                    <p class="text-slate-800 dark:text-slate-200 font-bold text-lg mb-1">Jika merasa ini bermanfaat?</p>
                    <p class="text-slate-500 dark:text-slate-400 text-sm">Bagikan kebaikan ini ke keluarga dan sahabat.</p>
                </div>
                
                <a href={linkWhatsApp} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 bg-[#25D366] hover:bg-[#128C7E] text-white px-8 py-3.5 rounded-full font-bold transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-1 w-full sm:w-auto justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                      <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
                    </svg>
                    Bagikan ke WhatsApp
                </a>
            </div>

        </article>
    </div>
</MainLayout>

<style>
    .animate-fade-in { animation: fadeIn 0.4s ease-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    
    :global(.prose p) { margin-bottom: 1.5em; text-align: justify; }
</style>