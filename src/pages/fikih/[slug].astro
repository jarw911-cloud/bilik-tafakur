---
import MainLayout from '../../layouts/MainLayout.astro';
import { daftarFikih } from '../../data/fikih.js';

export function getStaticPaths() {
    return daftarFikih.map((materi) => {
        return {
            params: { slug: materi.slug || materi.judul.toLowerCase().replace(/\s+/g, '-') },
            props: { materi }
        };
    });
}

const { materi } = Astro.props;
---

<MainLayout title={`${materi.judul} - Bilik Tafakur`}>
    <div class="max-w-4xl mx-auto py-8 px-6 md:px-12 lg:px-16 md:py-12 animate-fade-in">
        
        <div class="mb-8">
            <a href="/fikih" class="text-sm font-bold text-emerald-700 dark:text-emerald-400 hover:text-emerald-500 transition-colors flex items-center gap-2 inline-flex">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                KEMBALI KE DAFTAR FIKIH
            </a>
        </div>

        <div class="bg-white dark:bg-slate-900 rounded-[2.5rem] border border-slate-200 dark:border-slate-800 shadow-xl overflow-hidden p-8 md:p-14">
            <h1 class="text-3xl md:text-5xl font-poppins font-bold text-emerald-900 dark:text-emerald-400 text-center mb-12">{materi.judul}</h1>
            
            <div class="text-right mb-10">
                <p class="font-serif text-4xl md:text-5xl text-slate-900 dark:text-slate-50 leading-[2.5]">{materi.arab}</p>
            </div>

            <div class="p-6 md:p-8 bg-slate-50 dark:bg-slate-800/50 rounded-3xl border-l-4 border-emerald-500 mb-10">
                <p class="text-lg md:text-xl text-slate-700 dark:text-slate-200 italic font-medium mb-3">"{materi.latin}"</p>
                <p class="text-base text-slate-600 dark:text-slate-400">{materi.arti}</p>
            </div>

            <div class="prose prose-slate dark:prose-invert prose-lg max-w-none text-slate-700 dark:text-slate-300 leading-relaxed custom-article" set:html={materi.narasi}></div>
            
            <div class="mt-12 pt-6 border-t border-slate-200 dark:border-slate-800 text-sm font-bold text-amber-600 dark:text-amber-500 uppercase tracking-widest leading-relaxed">
                DASAR HUKUM: <br/>
                <span class="font-normal text-slate-500 dark:text-slate-400 normal-case tracking-normal mt-2 block">{materi.riwayat}</span>
            </div>
        </div>
    </div>
</MainLayout>

<style>
    .animate-fade-in { animation: fadeIn 0.4s ease-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    :global(.custom-article p) { margin-bottom: 1.5em; }
    :global(.custom-article h3) { margin-top: 2em; margin-bottom: 1em; font-weight: bold; color: #065f46; }
    :global(.dark .custom-article h3) { color: #34d399; }
    :global(.custom-article ul) { list-style-type: disc; margin-left: 1.5rem; margin-bottom: 1.5em; }
    :global(.custom-article ol) { list-style-type: decimal; margin-left: 1.5rem; margin-bottom: 1.5em; }
    :global(.custom-article li) { margin-bottom: 0.5em; }
</style>