                    { k: "Terkadang yang kau butuhkan hanyalah tidur yang nyenyak dengan hati yang memaafkan.", s: "Nasihat" },
                    { k: "Pejamkan mata, serahkan sisa urusan hari ini pada Allah.", s: "Bilik Tafakur" },
                    { k: "Kelelahan yang paling menyiksa adalah lelah batin. Banyak-banyaklah berdzikir.", s: "Nasihat" },
