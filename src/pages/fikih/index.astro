---
import MainLayout from '../../layouts/MainLayout.astro';
import { daftarFikih } from '../../data/fikih.js';
---

<MainLayout title="Daftar Fikih - Bilik Tafakur">
    <div class="max-w-4xl mx-auto py-8">
        <h1 class="text-3xl font-bold text-emerald-900 dark:text-emerald-400 mb-6">Fikih & Ibadah</h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {daftarFikih.map((item) => (
                <a href={`/fikih/${item.slug}`} class="p-6 bg-white dark:bg-slate-900 rounded-2xl border border-slate-100 dark:border-slate-800 hover:border-emerald-500 transition-all">
                    <h3 class="font-bold text-slate-800 dark:text-slate-200">{item.judul}</h3>
                    <p class="text-sm text-slate-500 mt-2 line-clamp-2">{item.arti}</p>
                </a>
            ))}
        </div>
    </div>
</MainLayout>
