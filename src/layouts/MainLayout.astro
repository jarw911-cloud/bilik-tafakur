---
import Analytics from '@vercel/analytics/astro';
import { daftarDoa } from '../data/doa.js';
import { daftarFikih } from '../data/fikih.js'; 
import { daftarMotivasi } from '../data/motivasi.js';
const { 
    title = "Bilik Tafakur", 
    description = "Kumpulan doa, fikih, dan motivasi berlandaskan Nalar Teras.",
    image = "https://bilik-tafakur.my.id/og-banner.png" // Gantos mawi link gambar logo/banner web Panjenengan mangke

} = Astro.props;

const currentUrl = Astro.url.href;
---

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>

    <meta property="og:type" content="article" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={currentUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />
    
    </head>
<body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 selection:bg-emerald-200 dark:selection:bg-emerald-900">  
    <aside id="sidebar" class="fixed top-0 left-0 h-full w-72 bg-white dark:bg-slate-950 z-[120] transform -translate-x-full transition-transform duration-300 border-r border-slate-200 dark:border-slate-800 flex flex-col shadow-2xl">
        <div class="h-20 flex items-center px-6 border-b border-slate-100 dark:border-slate-800 bg-gradient-to-br from-emerald-50/50 to-white dark:from-emerald-950/20">
            <div class="flex items-center gap-3">
                <img src="/logo-bilik.svg" class="w-10 h-10 rounded-full" alt="Logo" />
                <h1 class="font-poppins font-bold text-lg text-emerald-800 dark:text-emerald-400">Bilik Tafakur</h1>
            </div>
        </div>

        <nav class="flex-1 px-3 py-6 space-y-1.5 overflow-y-auto no-scrollbar">
            <a href="/" class="flex items-center gap-4 px-4 py-3.5 rounded-2xl hover:bg-emerald-50 dark:hover:bg-emerald-900/20 group transition-all">
                <span>🏠</span> <span class="font-semibold text-sm">Beranda</span>
            </a>
            
            <a href="/alquran" class="flex items-center gap-4 px-4 py-3.5 rounded-2xl hover:bg-emerald-50 dark:hover:bg-emerald-900/20 group transition-all">
                <span>📖</span> <span class="font-semibold text-sm">Al-Quran Digital</span>
            </a>

            <div class="relative">
                <a href="#" id="nav-doa" class="flex items-center justify-between px-4 py-3.5 rounded-2xl hover:bg-emerald-50 dark:hover:bg-emerald-900/20 group">
                    <div class="flex items-center gap-4"><span>🤲</span> <span class="font-semibold text-sm">Doa Harian</span></div>
                    <svg id="icon-doa" class="w-4 h-4 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </a>
                <div id="submenu-doa" class="hidden flex-col gap-2 pl-[4.5rem] pr-4 py-3 mt-1 bg-slate-50/50 dark:bg-slate-900/30 rounded-xl border border-slate-100 dark:border-slate-800/50">
                    <a href="/doa" class="text-[12px] font-bold text-emerald-600 dark:text-emerald-500 hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors flex items-center gap-2 py-2 border-b border-slate-200/70 dark:border-slate-800 mb-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
                        <span>Lihat Semua Doa</span>
                    </a>
                    {daftarDoa && daftarDoa.slice(0, 10).map((item) => {
                        const slugDoa = item.slug || item.judul.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
                        return (
                        <a href={`/doa/${slugDoa}`} class="text-[12px] font-medium text-slate-500 hover:text-emerald-600 dark:text-slate-400 dark:hover:text-emerald-400 transition-colors flex items-center gap-2 py-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400/50 flex-shrink-0"></span> <span class="truncate">{item.judul}</span>
                        </a>
                        )
                    })}
                </div>
            </div>

            <div class="relative">
                <a href="#" id="nav-fikih" class="flex items-center justify-between px-4 py-3.5 rounded-2xl hover:bg-emerald-50 dark:hover:bg-emerald-900/20 group">
                    <div class="flex items-center gap-4"><span>🕋</span> <span class="font-semibold text-sm">Fikih & Ibadah</span></div>
                    <svg id="icon-fikih" class="w-4 h-4 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </a>
                <div id="submenu-fikih" class="hidden flex-col gap-2 pl-[4.5rem] pr-4 py-3 mt-1 bg-slate-50/50 dark:bg-slate-900/30 rounded-xl border border-slate-100 dark:border-slate-800/50">
                    <a href="/fikih" class="text-[12px] font-bold text-emerald-600 dark:text-emerald-500 hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors flex items-center gap-2 py-2 border-b border-slate-200/70 dark:border-slate-800 mb-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
                        <span>Lihat Semua Fikih</span>
                    </a>
                    {daftarFikih && daftarFikih.slice(0, 10).map((item) => {
                        const slugFikih = item.slug || item.judul.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
                        return (
                        <a href={`/fikih/${slugFikih}`} class="text-[12px] font-medium text-slate-500 hover:text-emerald-600 dark:text-slate-400 dark:hover:text-emerald-400 transition-colors flex items-center gap-2 py-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400/50 flex-shrink-0"></span> <span class="truncate">{item.judul}</span>
                        </a>
                        )
                    })}
                </div>
            </div>

            <div class="relative">
                <a href="#" id="nav-iqra" class="flex items-center justify-between px-4 py-3.5 rounded-2xl hover:bg-emerald-50 dark:hover:bg-emerald-900/20 group transition-all duration-300">
                    <div class="flex items-center gap-4">
                        <span class="flex items-center justify-center text-xl group-hover:scale-110 transition-transform flex-shrink-0">📕</span>
                        <span class="font-semibold text-sm tracking-tight">Iqra Digital</span>
                    </div>
                    <svg id="icon-iqra" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform duration-300 flex-shrink-0"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </a>
                <div id="submenu-iqra" class="hidden flex-col gap-2 pl-[4.5rem] pr-4 py-3 mt-1 bg-slate-50/50 dark:bg-slate-900/30 rounded-xl border border-slate-100 dark:border-slate-800/50">
                    <a href="/iqra" class="text-[12px] font-bold text-emerald-600 dark:text-emerald-500 hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors flex items-center gap-2 py-2 border-b border-slate-200/70 dark:border-slate-800 mb-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
                        <span>Lihat Semua Iqra</span>
                    </a>
                    {[1, 2, 3, 4, 5, 6].map((jilid) => (
                        <a href={`/iqra/jilid-${jilid}`} class="text-[12px] font-medium text-slate-500 hover:text-emerald-600 dark:text-slate-400 dark:hover:text-emerald-400 transition-colors flex items-center gap-2 py-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400/50 flex-shrink-0"></span> <span class="truncate">Iqra Jilid {jilid}</span>
                        </a>
                    ))}
                </div>
            </div>

            <div class="relative">
                <a href="#" id="nav-motivasi" class="flex items-center justify-between px-4 py-3.5 rounded-2xl hover:bg-emerald-50 dark:hover:bg-emerald-900/20 group transition-all duration-300">
                    <div class="flex items-center gap-4">
                        <span class="flex items-center justify-center text-xl group-hover:scale-110 transition-transform flex-shrink-0">✨</span>
                        <span class="font-semibold text-sm tracking-tight">Motivasi & Tafakur</span>
                    </div>
                    <svg id="icon-motivasi" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform duration-300 flex-shrink-0"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </a>
                <div id="submenu-motivasi" class="hidden flex-col gap-2 pl-[4.5rem] pr-4 py-3 mt-1 bg-slate-50/50 dark:bg-slate-900/30 rounded-xl border border-slate-100 dark:border-slate-800/50">
                    <a href="/motivasi" class="text-[12px] font-bold text-emerald-600 dark:text-emerald-500 hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors flex items-center gap-2 py-2 border-b border-slate-200/70 dark:border-slate-800 mb-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
                        <span>Lihat Semua Motivasi</span>
                    </a>
                    {daftarMotivasi && daftarMotivasi.slice(0, 10).map((item) => (
                        <a href={`/motivasi/${item.slug}`} class="text-[12px] font-medium text-slate-500 hover:text-emerald-600 dark:text-slate-400 dark:hover:text-emerald-400 transition-colors flex items-center gap-2 py-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400/50 flex-shrink-0"></span> <span class="truncate">{item.judul}</span>
                        </a>
                    ))}
                </div>
            </div>
        </nav>
        
        <div class="p-6 border-t border-slate-100 dark:border-slate-800 bg-emerald-50/30 dark:bg-black/20 mt-auto flex-shrink-0 text-center">
            <p class="text-[11px] text-emerald-800 dark:text-emerald-400 font-serif italic mb-1">"Mengharap Ridho Allah semata."</p>
            <div class="h-1 w-6 bg-emerald-300 dark:bg-emerald-700 mx-auto my-2 rounded-full"></div>
            <p class="text-[9px] text-slate-400 uppercase tracking-[0.2em] mb-1">Katur kagem</p>
            <p class="text-sm font-bold text-emerald-900 dark:text-white">Widd 🤍</p>
        </div>
    </aside>

    <div class="flex-1 flex flex-col overflow-hidden relative">
        <header class="h-16 flex items-center justify-between px-4 md:px-8 bg-white/70 dark:bg-slate-900/70 backdrop-blur-xl border-b border-slate-200 dark:border-slate-800 z-[130] relative">
            <div class="flex items-center gap-3">
                <button id="btn-menu" class="p-2.5 text-emerald-700 dark:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-900/30 rounded-2xl transition-all">
                    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                </button>
                <a href="/" class="font-poppins font-bold text-lg text-emerald-900 dark:text-emerald-400 hidden sm:block">Bilik Tafakur</a>
            </div>

            <div class="flex items-center gap-2 relative">
                <div id="global-search-container" class="flex items-center bg-slate-100 dark:bg-slate-800 rounded-full transition-all w-10 overflow-hidden relative z-[140]">
                    <button id="btn-search-trigger" class="w-10 h-10 flex-shrink-0 flex items-center justify-center text-slate-500 hover:text-emerald-600">
                        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    </button>
                    <input type="text" id="global-search-input" placeholder="Cari..." autocomplete="off" class="bg-transparent border-none focus:outline-none text-sm w-0 opacity-0 transition-all font-jakarta pr-4 dark:text-white" />
                </div>

                <div id="search-dropdown" class="absolute top-[120%] right-10 w-64 md:w-80 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl shadow-2xl opacity-0 invisible scale-95 origin-top-right transition-all z-[150] flex flex-col overflow-hidden">
                    <div id="search-results-list" class="max-h-72 overflow-y-auto p-2 flex flex-col gap-1 no-scrollbar"></div>
                    <div id="search-enter-hint" class="hidden p-3 bg-slate-50 dark:bg-black/20 text-center text-[10px] text-slate-500 border-t">Tekan <kbd class="font-mono">Enter</kbd> untuk hasil lengkap</div>
                </div>

                <button id="theme-toggle" class="p-2.5 rounded-2xl bg-slate-100 dark:bg-slate-800 shadow-sm">
                    <span class="hidden dark:block">☀️</span> <span class="block dark:hidden">🌙</span>
                </button>
            </div>
        </header>

        <main class="flex-1 overflow-y-auto no-scrollbar"><slot /></main>
        <div id="sidebar-overlay" class="fixed inset-0 bg-black/30 backdrop-blur-[2px] z-[90] hidden"></div>
    </div>

    <Analytics />

   <script is:inline define:vars={{ daftarDoa, daftarFikih, daftarMotivasi }}>
        document.addEventListener('DOMContentLoaded', () => {
            const searchContainer = document.getElementById('global-search-container');
            const searchTrigger = document.getElementById('btn-search-trigger');
            const searchInput = document.getElementById('global-search-input');
            const searchDropdown = document.getElementById('search-dropdown');
            const searchResultsList = document.getElementById('search-results-list');
            const searchEnterHint = document.getElementById('search-enter-hint');

            const allData = [
                ...(daftarDoa || []).map((item) => {
                    const slugDoa = item.slug || item.judul.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
                    return { title: item.judul, type: 'Doa', url: `/doa/${slugDoa}`, icon: '🤲' };
                }),
                ...(daftarFikih || []).map((item) => {
                    const slugFikih = item.slug || item.judul.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
                    return { title: item.judul, type: 'Fikih', url: `/fikih/${slugFikih}`, icon: '🕋' };
                }),
                ...(daftarMotivasi || []).map((item) => ({ title: item.judul, type: 'Motivasi', url: `/motivasi/${item.slug}`, icon: '✨' }))
            ];

            if(searchTrigger) {
                searchTrigger.onclick = () => {
                    const isOpen = searchContainer.classList.contains('w-48');
                    if (!isOpen) {
                        searchContainer.classList.replace('w-10', 'w-48');
                        searchContainer.classList.add('md:w-64', 'px-1');
                        searchInput.classList.replace('w-0', 'w-full');
                        searchInput.classList.replace('opacity-0', 'opacity-100');
                        searchInput.focus();
                    } else {
                        searchContainer.classList.replace('w-48', 'w-10');
                        searchContainer.classList.remove('md:w-64', 'px-1');
                        searchInput.classList.replace('w-full', 'w-0');
                        searchInput.classList.replace('opacity-100', 'opacity-0');
                        searchDropdown.classList.add('opacity-0', 'invisible');
                    }
                };
            }

            if(searchInput) {
                searchInput.oninput = (e) => {
                    const query = e.target.value.toLowerCase().trim();
                    searchResultsList.innerHTML = '';
                    if (query.length < 2) { searchDropdown.classList.add('opacity-0', 'invisible'); return; }

                    const filtered = allData.filter(item => item.title.toLowerCase().includes(query));
                    if (filtered.length > 0) {
                        filtered.slice(0, 5).forEach(item => {
                            const a = document.createElement('a');
                            a.href = item.url;
                            a.className = 'flex items-center gap-3 p-3 hover:bg-emerald-50 dark:hover:bg-slate-800 rounded-xl';
                            a.innerHTML = `<span class="text-lg">${item.icon}</span><div><p class="text-sm font-bold truncate">${item.title}</p><p class="text-[9px] uppercase font-bold text-emerald-600">${item.type}</p></div>`;
                            searchResultsList.appendChild(a);
                        });
                        searchDropdown.classList.remove('opacity-0', 'invisible');
                        searchEnterHint.classList.remove('hidden');
                    } else {
                        searchResultsList.innerHTML = `<div class="p-4 text-center text-sm text-slate-500 italic">Mboten wonten asil kagem "${query}"</div>`;
                        searchDropdown.classList.remove('opacity-0', 'invisible');
                        searchEnterHint.classList.add('hidden');
                    }
                };

                searchInput.onkeydown = (e) => {
                    if (e.key === 'Enter' && searchInput.value.trim() !== '') {
                        window.location.href = `/search?q=${encodeURIComponent(searchInput.value.trim())}`;
                    }
                };
            }

            document.addEventListener('click', (e) => {
                if (searchContainer && searchDropdown && !searchContainer.contains(e.target) && !searchDropdown.contains(e.target)) {
                    if (searchContainer.classList.contains('w-48')) {
                        searchTrigger.click(); 
                    }
                }
            });

            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebar-overlay');
            const btnMenu = document.getElementById('btn-menu');
            
            if(btnMenu) {
                btnMenu.onclick = () => {
                    sidebar.classList.remove('-translate-x-full');
                    overlay.classList.remove('hidden');
                };
            }
            if(overlay) {
                overlay.onclick = () => {
                    sidebar.classList.add('-translate-x-full');
                    overlay.classList.add('hidden');
                };
            }

            const setupDropdown = (btnId, subId, iconId) => {
                const btn = document.getElementById(btnId);
                const sub = document.getElementById(subId);
                const icon = document.getElementById(iconId);
                let isOpen = false;
                if(btn && sub) btn.onclick = (e) => {
                    e.preventDefault(); 
                    isOpen = !isOpen;
                    sub.classList.toggle('hidden', !isOpen);
                    sub.classList.toggle('flex', isOpen);
                    if(icon) icon.classList.toggle('rotate-180', isOpen);
                };
            };
            
            setupDropdown('nav-doa', 'submenu-doa', 'icon-doa');
            setupDropdown('nav-fikih', 'submenu-fikih', 'icon-fikih');
            setupDropdown('nav-iqra', 'submenu-iqra', 'icon-iqra');
            setupDropdown('nav-motivasi', 'submenu-motivasi', 'icon-motivasi');

            const themeToggle = document.getElementById('theme-toggle');
            if(themeToggle) {
                themeToggle.onclick = () => {
                    const isDark = document.documentElement.classList.toggle('dark');
                    localStorage.setItem('theme', isDark ? 'dark' : 'light');
                };
            }
        });
    </script>

    <style is:global>
        :root { --font-jakarta: 'Plus Jakarta Sans', sans-serif; --font-poppins: 'Poppins', sans-serif; }
        .font-jakarta { font-family: var(--font-jakarta); }
        .font-poppins { font-family: var(--font-poppins); }
        .font-serif { font-family: 'Amiri', serif; }
        .no-scrollbar::-webkit-scrollbar { width: 0px; height: 0px; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        html { scroll-behavior: smooth; }
    </style>
</body>
</html>