                    { k: "Sabar dan Sholat adalah penolong sejati.", s: "QS. Al-Baqarah: 45" },
                    { k: "Sedekah akan menghapus dosa sebagaimana air memadamkan api.", s: "HR. Tirmidzi" },
                    { k: "Jagalah lisan, karena ia bisa menembus apa yang tak tertembus oleh pedang.", s: "Imam Syafi'i" },
                    { k: "Mencintai karena Allah adalah ikatan iman yang paling kuat.", s: "HR. Ahmad" },
                    { k: "Banyak mengingat kematian akan menghidupkan hati.", s: "Nasihat Ulama" },
                    { k: "Bekerjalah untuk duniamu seakan kau hidup selamanya, beribadahlah seakan kau mati esok.", s: "Atsar" },
                    { k: "Kebaikan yang paling cepat balasannya adalah menyambung tali silaturahmi.", s: "HR. Abu Dawud" },
                    { k: "Semua masalah menjadi ringan jika diletakkan di bawah lututmu saat sujud.", s: "Bilik Tafakur" },
                    { k: "Jangan biarkan hari berlalu tanpa menambah amal kebaikan.", s: "Nasihat" },
                    { k: "Maafkan mereka yang bersalah padamu, agar Allah mengampuni kesalahanmu.", s: "Nasihat" },
                    { k: "Setiap tarikan napas adalah kesempatan baru untuk bertaubat.", s: "Nasihat Bijak" },
                    { k: "Berprasangka baiklah kepada Allah dalam segala hal yang kau temui.", s: "HR. Muslim" }
                ]
            };

            const deteksiEmosi = (teks) => {
                const kata = teks.toLowerCase();
                if (kata.includes('cape') || kata.includes('lelah') || kata.includes('berat') || kata.includes('mumet') || kata.includes('nyerah') || kata.includes('pusing') || kata.includes('ngantuk')) return 'lelah';
                if (kata.includes('sedih') || kata.includes('kecewa') || kata.includes('hancur') || kata.includes('nangis') || kata.includes('sakit') || kata.includes('patah')) return 'sedih';
                if (kata.includes('marah') || kata.includes('kesal') || kata.includes('emosi') || kata.includes('benci') || kata.includes('mangkel') || kata.includes('bego')) return 'marah';
                if (kata.includes('takut') || kata.includes('khawatir') || kata.includes('bingung') || kata.includes('cemas') || kata.includes('overthink') || kata.includes('gelisah') || kata.includes('deg')) return 'cemas';
                return 'umum';
            };

            const kirimCurhat = () => {
                const teks = inputCurhat.value.trim();
                if (!teks) return;

                // Kunci input agar cuma bisa sekali
                inputCurhat.disabled = true;
                btnSubmit.disabled = true;

                // Balon Chat User
                const userBubble = `
                    <div class="flex justify-end fade-in-up">
                        <div class="bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 px-6 py-4 rounded-3xl rounded-br-sm max-w-[85%] text-sm md:text-base border border-slate-200 dark:border-slate-700 shadow-sm leading-relaxed">
                            "${teks}"
                        </div>
                    </div>
                `;

                // Deteksi Emosi & MESIN PENGACAK 5 NASIHAT
                const kategori = deteksiEmosi(teks);
                
                // Salin array, lalu acak urutannya (Shuffle), ambil 5 yang paling depan
                const semuaNasihat = [...resepNasihat[kategori]];
                const nasihatAcak = semuaNasihat.sort(() => 0.5 - Math.random()).slice(0, 5);

                let aiQuotes = '';
                nasihatAcak.forEach(n => {
                    aiQuotes += `
                        <div class="mb-4 p-5 bg-white dark:bg-slate-900 rounded-2xl border border-emerald-100 dark:border-emerald-900/50 shadow-sm hover:border-emerald-300 dark:hover:border-emerald-700 transition-colors">
                            <p class="text-base md:text-lg font-serif text-slate-800 dark:text-slate-200 leading-relaxed">"${n.k}"</p>
                            <div class="flex items-center gap-3 mt-4">
                                <div class="w-6 h-[1px] bg-emerald-500"></div>
                                <p class="text-[10px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-widest">${n.s}</p>
                            </div>
                        </div>
                    `;
                });

                // Balon Chat AI
                const aiBubble = `
                    <div class="flex justify-start mt-2 fade-in-up" style="animation-delay: 0.3s; animation-fill-mode: both;">
                        <div class="bg-emerald-50/50 dark:bg-emerald-900/10 w-full px-4 md:px-8 py-8 rounded-3xl border border-emerald-100 dark:border-emerald-900/30">
                            <div class="flex items-center gap-3 mb-6">
                                <span class="text-2xl">✨</span>
                                <span class="text-sm font-bold text-emerald-800 dark:text-emerald-400 uppercase tracking-widest">Resep Penyejuk Batin</span>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                ${aiQuotes}
                            </div>
                        </div>
                    </div>
                `;

                chatHistory.innerHTML = userBubble + aiBubble;

                // Bersihkan dan ubah placeholder
                inputCurhat.value = '';
                inputCurhat.placeholder = "Semoga hatimu kembali tenang. (Sesi ditutup)";

                // Scroll mulus
                setTimeout(() => {
                    window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
                }, 100);
            };

            btnSubmit.onclick = kirimCurhat;
            inputCurhat.addEventListener('keypress', function (e) {
                if (e.key === 'Enter') kirimCurhat();
            });
        });
    </script>

    <style is:global>
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .fade-in-up { animation: fadeInUp 0.6s ease-out forwards; }
    </style>
</MainLayout>