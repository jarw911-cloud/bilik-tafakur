---
import MainLayout from '../../layouts/MainLayout.astro';
import { daftarFikih } from '../../data/fikih.js';
---

<MainLayout title="Fikih & Ibadah - Bilik Tafakur">
    <div class="max-w-4xl mx-auto py-8 px-6 md:px-12 lg:px-16 md:py-12 animate-fade-in">
        
        <div class="mb-10 text-center md:text-left">
            <h1 class="text-3xl md:text-4xl font-poppins font-bold text-emerald-900 dark:text-emerald-400 mb-3 tracking-tight">Fikih & Ibadah</h1>
            <p class="text-slate-600 dark:text-slate-400 text-sm md:text-base leading-relaxed">Panduan ringkas tata cara ibadah dinten-dinten.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {daftarFikih.map((item, index) => (
                <a href={`/fikih/${item.slug}`} class="group flex flex-col p-5 bg-white dark:bg-slate-900 rounded-2xl border border-slate-100 dark:border-slate-800 hover:border-emerald-500 transition-all shadow-sm">
                    <h3 class="font-bold text-lg text-slate-800 dark:text-slate-200 mb-2">{item.judul}</h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400 line-clamp-2">{item.arti}</p>
                </a>
            ))}
        </div>
    </div>
</MainLayout>