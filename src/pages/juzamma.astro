---
import MainLayout from '../layouts/MainLayout.astro';

// Mengambil seluruh data surat
const response = await fetch('https://api.quran.gading.dev/surah');
const responseData = await response.json();

// MANTRA PENYARING: Hanya ambil surat ke-78 sampai 114 (Juz 30)
const juzAmmaList = responseData.data.filter((surat: any) => surat.number >= 78 && surat.number <= 114);
---

<MainLayout title="Juz Amma">
    <div class="mb-12">
        <h1 class="text-3xl md:text-4xl font-serif font-bold text-slate-900 dark:text-white mb-4">Juz Amma</h1>
        <p class="text-slate-600 dark:text-slate-400">Kumpulan surat-surat pendek (Juz 30) untuk hafalan dan renungan.</p>
        
        <div class="relative mt-6 max-w-md">
            <input 
                type="text" 
                id="search-input"
                placeholder="Cari surat (misal: Ikhlas)..." 
                class="w-full px-6 py-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl focus:outline-none focus:ring-2 focus:ring-emerald-500/50 dark:text-white transition-all shadow-sm"
            />
            <span class="absolute right-5 top-3.5 text-slate-400">🔍</span>
        </div>
        
        <div class="mt-8 h-px w-full bg-slate-200 dark:bg-slate-800/50"></div>
    </div>

    <div id="surat-grid" class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {juzAmmaList.map((surat: any) => (
            <a 
                href={`/alquran/${surat.number}`} 
                data-name={surat.name.transliteration.id.toLowerCase()}
                class="surat-card group relative p-6 md:p-8 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl hover:border-emerald-500/50 dark:hover:border-emerald-500/50 hover:shadow-xl transition-all duration-300 block w-full"
            >
                <div class="flex items-center justify-between w-full relative z-10">
                    <div class="w-14 h-14 flex-shrink-0 bg-slate-50 dark:bg-slate-800 text-slate-500 dark:text-slate-400 rounded-xl flex items-center justify-center font-bold group-hover:bg-emerald-600 group-hover:text-white transition-all duration-300 border border-slate-100 dark:border-slate-700 shadow-sm">
                        {surat.number}
                    </div>

                    <div class="flex-1 text-center px-8">
                        <h2 class="font-bold text-xl md:text-2xl text-slate-800 dark:text-slate-100 group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors">
                            {surat.name.transliteration.id}
                        </h2>
                        <p class="text-[11px] md:text-xs uppercase tracking-widest text-slate-400 dark:text-slate-500 mt-2">
                            {surat.name.translation.id} • {surat.numberOfVerses} Ayat
                        </p>
                    </div>

                    <div class="flex-shrink-0 text-right min-w-[80px]">
                        <span class="text-3xl md:text-4xl font-serif text-slate-800 dark:text-slate-200 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                            {surat.name.short}
                        </span>
                    </div>
                </div>
                <div class="absolute inset-0 bg-emerald-50/30 dark:bg-emerald-900/10 opacity-0 group-hover:opacity-100 rounded-2xl transition-opacity duration-300"></div>
            </a>
        ))}
    </div>

    <script is:inline>
        const searchInput = document.getElementById('search-input');
        const cards = document.querySelectorAll('.surat-card');

        searchInput.addEventListener('input', (e) => {
            const term = e.target.value.toLowerCase();
            cards.forEach(card => {
                const name = card.getAttribute('data-name');
                if (name.includes(term)) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        });
    </script>
</MainLayout>