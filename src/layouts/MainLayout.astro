---
const { title } = Astro.props;
---

<html lang="id">
<head>
    
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | Bilik Tafakur</title>
    
    <script is:inline>
        const theme = (() => {
            if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
                return localStorage.getItem('theme');
            }
            if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                return 'dark';
            }
            return 'light';
        })();
        if (theme === 'dark') {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#059669" />
</head>
<body class="bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-200 antialiased flex h-screen overflow-hidden transition-colors duration-300">
    
    <aside id="sidebar" class="bg-emerald-900 dark:bg-emerald-950 w-64 flex-shrink-0 transition-all duration-300 ease-in-out flex flex-col border-r border-emerald-800 shadow-xl z-20">
        <div class="p-6 flex items-center justify-between border-b border-emerald-800/50">
            <h1 id="logo-text" class="font-serif font-bold text-xl text-emerald-50 tracking-wide">Bilik Tafakur</h1>
            <button id="toggle-btn" class="p-2 text-emerald-100 hover:bg-emerald-800 rounded-lg transition">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
            </button>
        </div>

        <nav class="flex-1 px-4 py-6 space-y-2 overflow-y-auto">
            <a href="/" class="flex items-center p-3 text-emerald-100 hover:bg-emerald-800 rounded-xl transition group">
                <span class="mr-3 text-lg">🏠</span> <span class="nav-text">Beranda</span>
            </a>
            <a href="/alquran" class="flex items-center p-3 text-emerald-100 hover:bg-emerald-800 rounded-xl transition group">
                <span class="mr-3 text-lg">📖</span> <span class="nav-text">Al-Quran</span>
            </a>
            <a href="/doa" class="flex items-center p-3 text-emerald-100 hover:bg-emerald-800 rounded-xl transition group">
                <span class="mr-3 text-lg">🤲</span> <span class="nav-text">Doa Harian</span>
            </a>
            <a href="/motivasi" class="flex items-center p-3 text-emerald-100 hover:bg-emerald-800 rounded-xl transition group">
                <span class="mr-3 text-lg">✨</span> <span class="nav-text">Motivasi</span>
            </a>
            <a href="/juzamma" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-emerald-800/30 text-slate-300 hover:text-white transition">
    <span>📖</span> Juz Amma
</a><a href="/iqra" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-emerald-800/30 text-slate-300 hover:text-white transition">
    <span>📗</span> Iqra' Digital
</a>
        </nav>

        <div class="p-4 border-t border-emerald-800/50 text-[10px] text-emerald-400 text-center nav-text italic">
            "Menepi dalam Doa"
        </div>
    </aside>

    <div class="flex-1 flex flex-col overflow-hidden">
        <header class="h-16 flex items-center justify-between px-8 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 z-10 shadow-sm">
            <div class="flex items-center gap-4">
                <span class="md:hidden font-serif font-bold text-emerald-900 dark:text-emerald-400">Bilik Tafakur</span>
            </div>
            
            <div class="flex items-center gap-4">
                <button id="theme-toggle" class="p-2 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700 transition">
                    <span class="hidden dark:block">☀️</span>
                    <span class="block dark:hidden">🌙</span>
                </button>
            </div>
        </header>

        <main class="flex-1 overflow-y-auto bg-slate-50 dark:bg-slate-950">
            <div class="max-w-4xl w-full mx-auto p-4 md:p-12">
                <slot />
            </div>
        </main>
    </div>

    <script>
        // Fungsi Tombol Sidebar
        const toggleBtn = document.getElementById('toggle-btn');
        const sidebar = document.getElementById('sidebar');
        const navTexts = document.querySelectorAll('.nav-text');
        const logoText = document.getElementById('logo-text');

        // Kita tambahkan pengecekan if (sidebar && logoText) agar TypeScript tenang
        if (toggleBtn && sidebar && logoText) {
            toggleBtn.addEventListener('click', () => {
                sidebar.classList.toggle('w-64');
                sidebar.classList.toggle('w-20');
                navTexts.forEach(t => t.classList.toggle('hidden'));
                logoText.classList.toggle('hidden');
            });
        }

        // Fungsi Tombol Dark Mode
        const themeToggle = document.getElementById('theme-toggle');
        
        if (themeToggle) {
            themeToggle.addEventListener('click', () => {
                document.documentElement.classList.toggle('dark');
                const isDark = document.documentElement.classList.contains('dark');
                localStorage.setItem('theme', isDark ? 'dark' : 'light');
            });
        }
    </script>
</body>
</html>