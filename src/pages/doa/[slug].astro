---
import MainLayout from '../../layouts/MainLayout.astro';
import { daftarDoa } from '../../data/doa.js';

export function getStaticPaths() {
    return daftarDoa.map((materi) => {
        const slugOtomatis = materi.slug || materi.judul.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
        return {
            params: { slug: slugOtomatis },
            props: { materi }
        };
    });
}

const { materi } = Astro.props;
---

<MainLayout title={`${materi.judul} - Bilik Tafakur`}>
    <div class="max-w-4xl mx-auto py-8 px-6 md:px-12 lg:px-16 md:py-12 animate-fade-in">
        
        <div class="mb-8">
            <a href="/doa" class="text-sm font-bold text-emerald-700 dark:text-emerald-400 hover:text-emerald-500 transition-colors flex items-center gap-2 inline-flex">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                KEMBALI KE DAFTAR DOA
            </a>
        </div>

        <div class="bg-white dark:bg-slate-900 rounded-[2.5rem] border border-slate-200 dark:border-slate-800 shadow-xl overflow-hidden p-8 md:p-14">
            <div class="text-center mb-12 border-b border-slate-200 dark:border-slate-800 pb-8">
                <span class="text-4xl mb-4 block">🤲</span>
                <h1 class="text-3xl md:text-4xl lg:text-5xl font-poppins font-bold text-emerald-900 dark:text-emerald-400">{materi.judul}</h1>
            </div>
            
           <div class="text-center mb-12 px-4 md:px-8">
                <p dir="rtl" class="font-serif text-4xl md:text-5xl lg:text-6xl text-slate-900 dark:text-slate-50" style="line-height: 2.5;">{materi.arab}</p>
            </div>

            <div class="p-6 md:p-10 bg-emerald-50/50 dark:bg-emerald-900/10 rounded-3xl border border-emerald-100 dark:border-emerald-800/30 text-center">
                <p class="text-lg md:text-xl text-emerald-800 dark:text-emerald-300 italic font-medium mb-6 font-jakarta leading-relaxed">
                    "{materi.latin}"
                </p>
                <div class="h-px w-16 bg-emerald-200 dark:bg-emerald-800 mx-auto mb-6"></div>
                <p class="text-base md:text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
                    <span class="font-bold uppercase tracking-widest text-xs block mb-2 text-slate-400">Artinya:</span> 
                    <span class="font-medium text-slate-700 dark:text-slate-200">{materi.arti}</span>
                </p>
            </div>
        </div>
    </div>
</MainLayout>

<style>
    .animate-fade-in { animation: fadeIn 0.4s ease-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>