---
import MainLayout from '../layouts/MainLayout.astro';
import { daftarDoa } from '../data/doa.js';
import { daftarFikih } from '../data/fikih.js';
import { daftarMotivasi } from '../data/motivasi.js'; // TAMBAHAN: Import data motivasi
---

<MainLayout title="Hasil Pencarian - Bilik Tafakur">
    <div class="max-w-4xl mx-auto py-4 px-4 sm:px-6 animate-fade-in">
        
        <div class="mb-10 text-center md:text-left mt-8">
            <h1 class="text-3xl md:text-4xl font-poppins font-bold text-emerald-900 dark:text-emerald-400 mb-3 tracking-tight">Hasil Pencarian</h1>
            <p class="text-slate-600 dark:text-slate-400 text-sm md:text-base leading-relaxed">
                Menampilkan asil kagem: <span id="search-query-display" class="font-bold italic text-emerald-600 dark:text-emerald-400 text-lg">...</span>
            </p>
        </div>

        <div id="search-results-container" class="grid grid-cols-1 md:grid-cols-2 gap-4">
            </div>

        <div id="no-results" class="hidden text-center py-20 bg-white dark:bg-slate-900 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm mt-8">
            <span class="text-5xl mb-4 block animate-bounce">🍃</span>
            <h2 class="text-xl md:text-2xl font-bold text-slate-800 dark:text-slate-200 mb-2">Mboten Wonten Asil</h2>
            <p class="text-slate-500 dark:text-slate-400 text-sm md:text-base max-w-md mx-auto">Padosan Panjenengan dèrèng saged dipun-panggihaken wonten ing Bilik Tafakur. Cobi ngginakaken tembung sanèsipun.</p>
            <a href="/" class="inline-block mt-8 px-8 py-3.5 bg-emerald-600 hover:bg-emerald-700 dark:bg-emerald-700 dark:hover:bg-emerald-600 text-white font-medium rounded-xl transition-all shadow-md hover:shadow-lg">
                Wangsul dhateng Beranda
            </a>
        </div>
    </div>

    <script is:inline define:vars={{ daftarDoa, daftarFikih, daftarMotivasi }}>
        document.addEventListener('DOMContentLoaded', () => {
            // Njukuk tembung sing dipadosi saking URL (tuladha: ?q=wudhu)
            const urlParams = new URLSearchParams(window.location.search);
            const query = urlParams.get('q');
            
            const displayQuery = document.getElementById('search-query-display');
            const resultsContainer = document.getElementById('search-results-container');
            const noResults = document.getElementById('no-results');

            if (query && query.trim() !== '') {
                displayQuery.innerText = `"${query}"`;
                const lowerQuery = query.toLowerCase().trim();

                // Dadekne siji data Doa, Fikih, lan Motivasi (Ngapiki URL Slug)
                const allData = [
                    ...(daftarDoa || []).map((item) => {
                        const slug = item.slug || item.judul.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
                        return { title: item.judul, type: 'Doa', url: `/doa/${slug}`, icon: '🤲', desc: item.arti || "Baca panduan doa lengkapnya." }
                    }),
                    ...(daftarFikih || []).map((item) => {
                        const slug = item.slug || item.judul.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
                        return { title: item.judul, type: 'Fikih', url: `/fikih/${slug}`, icon: '🕋', desc: item.narasi ? item.narasi.replace(/<[^>]*>?/gm, '').substring(0, 100) + "..." : "Pelajari kajian fikih ini." }
                    }),
                    // TAMBAHAN: Ngolah data motivasi
                    ...(daftarMotivasi || []).map((item) => {
                        return { title: item.judul, type: 'Motivasi', url: `/motivasi/${item.slug}`, icon: '✨', desc: item.cuplikan || "Renungan Nalar Teras." }
                    })
                ];

                // Golek sing judule utawi deskripsine padha karo sing diketik
                const filtered = allData.filter(item => 
                    (item.title && item.title.toLowerCase().includes(lowerQuery)) || 
                    (item.desc && item.desc.toLowerCase().includes(lowerQuery))
                );

                // Nampilake asil
                if (filtered.length > 0) {
                    filtered.forEach((item) => {
                        const card = document.createElement('a');
                        card.href = item.url;
                        card.className = "group flex flex-col p-5 md:p-6 bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-800 hover:shadow-md hover:border-emerald-300 dark:hover:border-emerald-700 transition-all";
                        card.innerHTML = `
                            <div class="flex items-center justify-between mb-4">
                                <div class="flex items-center gap-3">
                                    <span class="w-12 h-12 flex items-center justify-center bg-emerald-50 dark:bg-emerald-950 text-2xl rounded-xl shadow-inner">${item.icon}</span>
                                    <span class="text-[10px] text-emerald-600 dark:text-emerald-400 uppercase tracking-widest font-bold px-2.5 py-1 bg-emerald-50 dark:bg-emerald-900/30 rounded-md border border-emerald-100 dark:border-emerald-800">${item.type}</span>
                                </div>
                                <div class="w-8 h-8 rounded-full bg-slate-50 dark:bg-slate-800 flex items-center justify-center group-hover:bg-emerald-100 dark:group-hover:bg-emerald-900 transition-colors">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-slate-300 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors"><path d="m9 18 6-6-6-6"/></svg>
                                </div>
                            </div>
                            <h3 class="font-bold text-lg md:text-xl text-slate-800 dark:text-slate-200 group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors mb-2">${item.title}</h3>
                            <p class="text-sm text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed">${item.desc}</p>
                        `;
                        resultsContainer.appendChild(card);
                    });
                } else {
                    // Nek blas ora ana sing nyantol
                    noResults.classList.remove('hidden');
                }
            } else {
                // Nek URL kosong (ora ngetik opo-opo)
                displayQuery.innerText = "Kosong";
                noResults.classList.remove('hidden');
            }
        });
    </script>

    <style>
        .animate-fade-in { animation: fadeIn 0.4s ease-out; }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        /* Kagem mbatesi tulisan dadi 2 baris kemawon */
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;  
            overflow: hidden;
        }
    </style>
</MainLayout>