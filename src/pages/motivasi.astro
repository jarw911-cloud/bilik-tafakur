---
import MainLayout from '../layouts/MainLayout.astro';

const kumpulanMotivasi = [
    { kutipan: "Hati yang tenang adalah awal dari ibadah yang khusyuk.", sumber: "Bilik Tafakur", kategori: "Ketenangan" },
    { kutipan: "Maka sesungguhnya bersama kesulitan ada kemudahan.", sumber: "QS. Al-Insyirah: 5", kategori: "Al-Quran" },
    { kutipan: "Cukuplah Allah bagi kami, dan Dia adalah sebaik-baik pelindung.", sumber: "QS. Ali Imran: 173", kategori: "Al-Quran" },
    { kutipan: "Jangan menjelaskan tentang dirimu kepada siapapun, karena yang menyukaimu tidak butuh itu, dan yang membencimu tidak percaya itu.", sumber: "Ali bin Abi Thalib", kategori: "Nasihat Sahabat" },
    { kutipan: "Dunia hanyalah tempat persinggahan, akhirat adalah tujuan abadi.", sumber: "Nasihat Bijak", kategori: "Tafakur" },
    { kutipan: "Boleh jadi kamu membenci sesuatu, padahal ia amat baik bagimu.", sumber: "QS. Al-Baqarah: 216", kategori: "Al-Quran" },
    { kutipan: "Apa yang sudah ditakdirkan untukmu, takkan pernah melewatkanmu.", sumber: "Umar bin Khattab", kategori: "Nasihat Sahabat" },
    { kutipan: "Terkadang hati harus patah agar cahaya hidayah bisa masuk melaluinya.", sumber: "Jalaluddin Rumi", kategori: "Tafakur" },
    { kutipan: "Jangan memikul beban esok hari pada pundak hari ini.", sumber: "Pepatah Arab", kategori: "Nalar Teras" },
    { kutipan: "Orang yang paling kuat bukanlah yang jago bergulat, tapi yang bisa menahan amarahnya.", sumber: "HR. Bukhari", kategori: "Hadits" }
];
---

<MainLayout title="Motivasi & Tafakur">
    <div class="mb-10 text-center md:text-left">
        <h1 class="text-3xl md:text-4xl font-poppins font-bold text-emerald-900 dark:text-emerald-400 mb-3 tracking-tight flex items-center justify-center md:justify-start gap-3">
            <span>✨</span> Motivasi & Tafakur
        </h1>
        <p class="text-slate-600 dark:text-slate-400 text-sm md:text-base leading-relaxed">
            Kumpulan hikmah, kutipan Al-Quran, lan nalar teras kagem nguatake jiwa.
        </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {kumpulanMotivasi.map((item) => (
            <div class="bg-white dark:bg-slate-900 p-6 md:p-8 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-800 hover:shadow-md hover:-translate-y-1 transition-all duration-300 relative overflow-hidden group">
                
                <div class="absolute top-0 right-0 w-24 h-24 bg-emerald-50 dark:bg-emerald-900/10 rounded-bl-full -mr-4 -mt-4 transition-transform group-hover:scale-110"></div>
                
                <div class="relative z-10">
                    <span class="inline-block px-3 py-1 mb-5 text-[10px] font-bold text-emerald-700 dark:text-emerald-300 bg-emerald-100 dark:bg-emerald-900/50 rounded-full uppercase tracking-widest">
                        {item.kategori}
                    </span>
                    
                    <p class="text-lg md:text-xl font-serif text-slate-800 dark:text-slate-200 leading-relaxed italic mb-6">
                        "{item.kutipan}"
                    </p>
                    
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-[1px] bg-emerald-400 dark:bg-emerald-600"></div>
                        <p class="text-sm font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-widest">
                            {item.sumber}
                        </p>
                    </div>
                </div>
            </div>
        ))}
    </div>
</MainLayout>