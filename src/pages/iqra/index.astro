---
import MainLayout from '../../layouts/MainLayout.astro';

const jilids = [
	{ no: 1, deskripsi: 'Pengenalan Huruf Hijaiyah Berharakat Fathah.', color: 'from-orange-400 to-red-500' },
	{ no: 2, deskripsi: 'Mengenal Huruf Sambung dan Mad Thabi’i.', color: 'from-emerald-400 to-teal-500' },
	{ no: 3, deskripsi: 'Mengenal Harakat Kasrah dan Dhammah.', color: 'from-blue-400 to-indigo-500' },
	{ no: 4, deskripsi: 'Mengenal Tanwin dan Huruf Sukun.', color: 'from-purple-400 to-pink-500' },
	{ no: 5, deskripsi: 'Mengenal Bacaan Tasydid dan Idgham.', color: 'from-yellow-400 to-amber-600' },
	{ no: 6, deskripsi: 'Mengenal Hukum Tajwid Terapan dan Ayat Panjang.', color: 'from-slate-600 to-slate-900' }
];
---

<MainLayout title="Iqra Digital - Bilik Tafakur">
	<div class="max-w-6xl mx-auto py-12 px-8 md:px-12 lg:px-16 animate-fade-in">
		<div class="mb-12 border-b border-slate-200 dark:border-slate-800 pb-8 text-center md:text-left">
            <h1 class="text-3xl md:text-5xl font-poppins font-bold text-emerald-900 dark:text-emerald-400 mb-4 tracking-tight">
               📕 Iqra Digital
            </h1>
            <p class="text-slate-600 dark:text-slate-400 text-lg leading-relaxed font-jakarta">
                Media sinau ngaji lare-lare kanthi gampil lan interaktif.
            </p>
        </div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
			{jilids.map((j) => (
				<a href={`/iqra/jilid-${j.no}`} class="group relative overflow-hidden rounded-[2rem] bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 hover:shadow-2xl transition-all duration-500">
					<div class={`h-32 bg-gradient-to-br ${j.color} flex items-center justify-center relative overflow-hidden`}>
						<span class="text-8xl font-black text-white opacity-20 absolute -right-4 -bottom-4">{j.no}</span>
						<h2 class="text-4xl font-black text-white">JILID {j.no}</h2>
					</div>
					<div class="p-6">
						<p class="text-slate-500 dark:text-slate-400 text-sm mb-6 leading-relaxed">
							{j.deskripsi}
						</p>
						<div class="flex items-center gap-2 text-xs font-bold text-emerald-600 group-hover:translate-x-2 transition-transform uppercase tracking-widest">
							Mulai Belajar <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
						</div>
					</div>
				</a>
			))}
		</div>
	</div>
</MainLayout>