---
import MainLayout from '../layouts/MainLayout.astro';

const motivasi = [
    { text: "Hati yang tenang adalah awal dari ibadah yang khusyuk.", source: "Bilik Tafakur" },
    { text: "Maka sesungguhnya bersama kesulitan ada kemudahan.", source: "QS. Al-Insyirah: 5" },
    { text: "Cukuplah Allah bagi kami, dan Dia adalah sebaik-baik pelindung.", source: "QS. Ali Imran: 173" },
    { text: "Jangan menjelaskan tentang dirimu kepada siapapun, karena yang menyukaimu tidak butuh itu.", source: "Ali bin Abi Thalib" },
    { text: "Dunia hanyalah tempat persinggahan, akhirat adalah tujuan abadi.", source: "Nasihat Bijak" }
];
const randomQuote = motivasi[Math.floor(Math.random() * motivasi.length)];
---

<MainLayout title="Beranda">
    <div class="flex flex-col items-center justify-start min-h-[80vh] text-center max-w-3xl mx-auto relative pb-40 pt-4">
        
        <div id="last-read-container" class="hidden mb-6">
            <a id="last-read-link" href="#" class="inline-flex items-center gap-3 px-5 py-2.5 bg-emerald-50 dark:bg-emerald-900/30 border border-emerald-200 dark:border-emerald-800 rounded-full text-sm font-medium text-emerald-800 dark:text-emerald-300 hover:shadow-md hover:scale-105 transition-all duration-300">
                <span class="flex h-2.5 w-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                Lanjutkan Membaca: <strong id="last-read-name"></strong>
            </a>
        </div>

        <div class="w-full mb-12">
            <div class="bg-white/60 dark:bg-slate-900/60 backdrop-blur-md border border-slate-200 dark:border-slate-800 rounded-3xl p-6 shadow-sm">
                <div class="flex flex-col md:flex-row justify-between items-center mb-6 gap-2">
                    <div class="text-center md:text-left">
                        <h3 class="text-lg font-bold text-slate-800 dark:text-slate-100 flex items-center justify-center md:justify-start gap-2">
                            <span class="text-emerald-600">🕌</span> Jadwal Sholat
                        </h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Temanggung & Sekitarnya</p>
                    </div>
                    <div class="text-center md:text-right">
                        <p class="text-sm font-semibold text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-900/30 px-3 py-1 rounded-lg inline-block" id="tanggal-sholat">Memuat waktu...</p>
                    </div>
                </div>
                
                <div class="grid grid-cols-5 gap-2 md:gap-4" id="waktu-sholat-container">
                    <div class="col-span-5 text-sm text-slate-400 animate-pulse py-4">Menyelaraskan waktu dengan matahari...</div>
                </div>
            </div>
        </div>

        <span class="px-4 py-1.5 bg-emerald-100 dark:bg-emerald-900/50 text-emerald-800 dark:text-emerald-300 text-xs font-semibold rounded-full uppercase tracking-widest mb-8 border border-transparent dark:border-emerald-800/50">
            Tafakur Hari Ini
        </span>

        <blockquote class="relative">
            <h2 class="text-3xl md:text-5xl font-serif italic text-slate-900 dark:text-white leading-tight mb-6 transition-colors duration-300">
                "{randomQuote.text}"
            </h2>
            <cite class="text-lg text-slate-500 dark:text-slate-400 not-italic transition-colors duration-300">— {randomQuote.source}</cite>
        </blockquote>

        <div class="mt-12 flex flex-wrap justify-center gap-4">
            <a href="/alquran" class="px-8 py-3 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-full text-sm font-bold hover:scale-105 transition-transform shadow-md">
                Baca Al-Quran
            </a>
            <a href="/doa" class="px-8 py-3 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-full text-sm font-bold text-slate-800 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 transition shadow-sm">
                Kumpulan Doa
            </a>
        </div>

        <div id="chat-history" class="w-full mt-16 flex flex-col gap-6 text-left"></div>
    </div>

    <div class="fixed bottom-0 left-0 w-full z-50 bg-gradient-to-t from-slate-50 via-slate-50 to-transparent dark:from-[#0f172a] dark:via-[#0f172a] dark:to-transparent pt-12 pb-6 px-4">
        <div class="max-w-3xl mx-auto relative">
            <div class="relative flex items-center bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-full p-2 shadow-[0_8px_30px_rgb(0,0,0,0.08)] dark:shadow-[0_8px_30px_rgb(0,0,0,0.4)] focus-within:ring-2 focus-within:ring-emerald-500/50 focus-within:border-emerald-500 transition-all duration-300">
                <span class="pl-4 text-2xl">🌱</span>
                <input 
                    type="text" 
                    id="curhat-input" 
                    class="w-full bg-transparent border-none px-4 py-3 text-sm md:text-base text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-0 placeholder-slate-400 dark:placeholder-slate-500 disabled:opacity-50" 
                    placeholder="Apa yang sedang Panjenengan rasakan hari ini? (Ketik keluh kesah di sini...)" 
                    autocomplete="off" 
                />
               <button 
                    id="btn-submit-curhat" 
                    class="w-10 h-10 md:w-12 md:h-12 flex-shrink-0 bg-slate-900 dark:bg-emerald-600 text-white rounded-full flex items-center justify-center hover:bg-emerald-700 hover:scale-105 transition-all shadow-sm ml-2 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100"
                    title="Kirim Keluh Kesah"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 19V5"/>
                        <path d="m5 12 7-7 7 7"/>
                    </svg>
                </button>
            </div>
            <p class="text-[10.5px] text-center text-slate-400 dark:text-slate-500 mt-4 tracking-wide font-medium">
                Sistem P3K Batin ini hanya bisa digunakan sekali per kunjungan untuk menjaga kekhusyukan.
            </p>
        </div>
    </div>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', async () => {
            // 1. TERAKHIR BACA
            const lastId = localStorage.getItem('lastReadId');
            const lastName = localStorage.getItem('lastReadName');
            const lastAyat = localStorage.getItem('lastReadAyat');
            if (lastId && lastName) {
                document.getElementById('last-read-container').classList.remove('hidden');
                let displayText = lastName;
                let targetUrl = `/alquran/${lastId}`;
                if (lastAyat) { displayText += ` - Ayat ${lastAyat}`; targetUrl += `#ayat-${lastAyat}`; }
                document.getElementById('last-read-name').innerText = displayText;
                document.getElementById('last-read-link').href = targetUrl;
            }

            // 2. JADWAL SHOLAT
            const container = document.getElementById('waktu-sholat-container');
            const tanggalEl = document.getElementById('tanggal-sholat');
            try {
                const res = await fetch('https://api.aladhan.com/v1/timingsByCity?city=Temanggung&country=Indonesia&method=20');
                const data = await res.json();
                if(data.code === 200) {
                    const timings = data.data.timings;
                    tanggalEl.innerText = new Date().toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
                    const jadwal = [{nama:'Subuh',waktu:timings.Fajr},{nama:'Dzuhur',waktu:timings.Dhuhr},{nama:'Ashar',waktu:timings.Asr},{nama:'Maghrib',waktu:timings.Maghrib},{nama:'Isya',waktu:timings.Isha}];
                    let html = '';
                    jadwal.forEach(j => { html += `<div class="text-center p-2 md:p-3 bg-white dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm hover:border-emerald-500 transition group cursor-default"><p class="text-[10px] md:text-xs font-bold text-slate-500 dark:text-slate-400 group-hover:text-emerald-600 uppercase tracking-wider mb-1">${j.nama}</p><p class="text-sm md:text-xl font-bold text-emerald-700 dark:text-emerald-400">${j.waktu}</p></div>`; });
                    container.innerHTML = html;
                }
            } catch (error) { container.innerHTML = '<p class="text-center w-full col-span-5 text-sm text-red-500">Gagal memuat jadwal sholat.</p>'; }

            // 3. DATABASE NASIHAT MASIF (Diperbanyak)
            const inputCurhat = document.getElementById('curhat-input');
            const btnSubmit = document.getElementById('btn-submit-curhat');
            const chatHistory = document.getElementById('chat-history');

            const resepNasihat = {
                lelah: [
                    { k: "Istirahatlah sejenak, dunia tidak akan hancur karena kau merebahkan badan.", s: "Nasihat" },
                    { k: "Lelahmu hari ini adalah bekal senyummu di akhirat kelak.", s: "Bilik Tafakur" },
                    { k: "Jangan memikul beban esok hari pada pundak hari ini.", s: "Pepatah Arab" },
                    { k: "Allah tidak membebani seseorang melainkan sesuai dengan kesanggupannya.", s: "QS. Al-Baqarah: 286" },
                    { k: "Setiap tetes keringat lelahmu dalam mencari kebaikan akan bernilai pahala.", s: "Hadits" },
                    { k: "Tidurlah, tubuhmu juga memiliki hak atas dirimu.", s: "HR. Bukhari" },
                    { k: "Lelah dalam ketaatan lebih manis daripada segar dalam kemaksiatan.", s: "Ulama Salaf" },
                    { k: "Orang hebat tidak dihasilkan dari kemudahan, kesenangan, dan kenyamanan.", s: "Nasihat" },
                    { k: "Rasa lelah ini hanya mampir, sabarlah sebentar.", s: "Bilik Tafakur" },
                    { k: "Jadikan lelahmu sebagai lillah (karena Allah), maka ia akan menjadi alhamdulillah.", s: "Nasihat Bijak" },
                    { k: "Beban ini berat, tapi pundakmu diciptakan cukup kuat untuk memikulnya.", s: "Bilik Tafakur" },
                    { k: "Berhentilah sejenak, bukan untuk menyerah, tapi untuk menghela napas panjang.", s: "Nasihat" },
                    { k: "Pahala orang yang bersabar di kala lelah tanpa keluh kesah itu tanpa batas.", s: "QS. Az-Zumar: 10" },
                    { k: "Jika dunia membuatmu lelah, jadikan sholat sebagai istirahatmu.", s: "Hadits" },
                    { k: "Tidak ada lelah yang sia-sia di mata Allah.", s: "Bilik Tafakur" },
                    { k: "Hanya di surga kelak tidak ada kata lelah. Bertahanlah hingga ke sana.", s: "Nasihat Sufi" },
                    { k: "Keringat yang menetes karena lelah mencari rezeki halal akan memadamkan api neraka.", s: "Atsar" },
                    { k: "Semoga lelahmu menjadi pelebur dosa-dosamu yang lalu.", s: "HR. Muslim" },
