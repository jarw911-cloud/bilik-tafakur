---
import MainLayout from '../../layouts/MainLayout.astro';

export function getStaticPaths() {
    return [
        { params: { jilid: '1' } }, { params: { jilid: '2' } }, { params: { jilid: '3' } },
        { params: { jilid: '4' } }, { params: { jilid: '5' } }, { params: { jilid: '6' } }
    ];
}

const { jilid } = Astro.params;
---

<MainLayout title={`Iqra' Jilid ${jilid} - Segera Hadir`}>
    
    <div class="flex items-center justify-between mb-8">
        <a href="/iqra" class="inline-flex items-center text-sm font-medium text-slate-500 hover:text-emerald-600 dark:text-slate-400 dark:hover:text-emerald-400 transition-colors group">
            <span class="mr-2 group-hover:-translate-x-1 transition-transform">←</span> Rak Buku Iqra
        </a>
        <h1 class="text-2xl font-bold text-slate-800 dark:text-white">Iqra' Jilid {jilid}</h1>
    </div>

    <div class="max-w-2xl mx-auto bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-10 md:p-16 text-center shadow-sm min-h-[60vh] flex flex-col items-center justify-center relative overflow-hidden">
        
        <div class="absolute top-0 right-0 w-64 h-64 bg-emerald-50 dark:bg-emerald-900/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3"></div>
        <div class="absolute bottom-0 left-0 w-48 h-48 bg-emerald-50 dark:bg-emerald-900/10 rounded-full blur-3xl translate-y-1/3 -translate-x-1/3"></div>

        <div class="relative z-10">
            <div class="w-24 h-24 bg-emerald-100 dark:bg-emerald-900/50 text-emerald-600 dark:text-emerald-400 rounded-full flex items-center justify-center mx-auto mb-8 animate-bounce shadow-inner border border-emerald-200 dark:border-emerald-800/50">
                <span class="text-4xl">⏳</span>
            </div>

            <h2 class="text-3xl md:text-4xl font-serif font-bold text-slate-800 dark:text-white mb-4">
                Segera Hadir
            </h2>
            <p class="text-slate-600 dark:text-slate-400 text-lg mb-8 max-w-md mx-auto leading-relaxed">
                Halaman digital untuk <strong class="text-emerald-600 dark:text-emerald-400">Iqra' Jilid {jilid}</strong> sedang dalam tahap penyusunan. InsyaAllah akan segera bisa digunakan untuk belajar.
            </p>

            <a href="/iqra" class="inline-flex items-center gap-2 px-6 py-3 bg-emerald-700 dark:bg-emerald-600 text-white rounded-full text-sm font-medium hover:bg-emerald-800 dark:hover:bg-emerald-500 transition shadow-sm hover:scale-105 duration-300">
                Kembali ke Rak Buku
            </a>
        </div>
    </div>

</MainLayout>