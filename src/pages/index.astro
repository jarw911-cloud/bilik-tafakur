                    { k: "Tarik napas panjang, dan katakan 'Alhamdulillah ala kulli hal'.", s: "Hadits" },
                    { k: "Air matamu mahal, jangan habiskan untuk menangisi dunia.", s: "Nasihat Ulama" },
                    { k: "Doa di kala sedih dan terjepit adalah anak panah yang langsung menembus langit.", s: "Bilik Tafakur" },
                    { k: "Semua akan berlalu. Yang tersisa hanyalah bagaimana sikapmu saat melewatinya.", s: "Ali bin Abi Thalib" },
                    { k: "Berikan ruang pada dirimu untuk merasa sedih, tapi jangan berikan izin untuk menyerah.", s: "Nasihat" },
                    { k: "Kesedihan ini adalah tamu, jamulah dengan sabar hingga ia pamit.", s: "Bilik Tafakur" },
                    { k: "Pahala kesabaranmu hari ini sedang ditabung untuk memberatkan timbanganmu kelak.", s: "Hadits" },
                    { k: "Peluklah dirimu sendiri dengan doa, Allah senantiasa memelukmu dengan rahmat-Nya.", s: "Nasihat" }
                ],
                marah: [
                    { k: "Orang yang kuat bukanlah yang jago bergulat, tapi yang bisa menahan amarahnya.", s: "HR. Bukhari" },
                    { k: "Jika marah saat berdiri, duduklah. Jika masih marah, berbaringlah.", s: "HR. Abu Dawud" },
                    { k: "Amarah bagaikan api, ia akan membakar kebaikanmu sendiri jika dibiarkan.", s: "Nasihat Bijak" },
                    { k: "Maafkanlah mereka, itu lebih menenangkan batinmu daripada menyimpan dendam.", s: "Bilik Tafakur" },
                    { k: "Jadilah pemaaf dan suruhlah orang mengerjakan yang ma'ruf.", s: "QS. Al-A'raf: 199" },
                    { k: "Marah itu dari setan, dan setan dari api. Padamkan dengan wudhu.", s: "HR. Abu Dawud" },
                    { k: "Diamlah ketika engkau sedang marah.", s: "HR. Ahmad" },
                    { k: "Menyimpan marah ibarat meminum racun tapi berharap orang lain yang mati.", s: "Pepatah" },
                    { k: "Berlapang dadalah, tak semua hal harus berjalan sesuai kehendakmu.", s: "Nasihat" },
                    { k: "Orang yang mulia adalah yang mudah memaafkan sebelum diminta.", s: "Nasihat Ulama" },
                    { k: "Kalahkan amarahmu dengan diam, kalahkan kebodohan dengan ilmu.", s: "Imam Syafi'i" },
                    { k: "Siapa yang menahan amarah padahal ia mampu melampiaskannya, Allah penuhi hatinya dengan kedamaian.", s: "HR. Abu Dawud" },
                    { k: "Mengalah bukan berarti kalah, tapi mengalahkan ego sendiri.", s: "Bilik Tafakur" },
                    { k: "Lepaskan beban dendam di hatimu, kau tak pantas membawa sampah di pikiranmu.", s: "Nasihat" },
                    { k: "Memaafkan adalah ciri jiwa yang merdeka.", s: "Bilik Tafakur" },
                    { k: "Jangan mengambil keputusan apa pun saat engkau sedang marah.", s: "Ali bin Abi Thalib" },
                    { k: "Tarik napas, ucapkan Ta'awudz. Lindungi dirimu dari bisikan setan yang mengipas amarah.", s: "Nasihat" },
                    { k: "Balaslah keburukan dengan cara yang lebih baik.", s: "QS. Fushshilat: 34" },
                    { k: "Ketenangan akan kembali saat kau menyadari bahwa Allah yang Maha Menghakimi.", s: "Nasihat" },
                    { k: "Semua hal di dunia ini terlalu sepele untuk merusak kedamaian hatimu.", s: "Bilik Tafakur" },
                    { k: "Doakan kebaikan bagi mereka yang memancing emosimu, hatimu akan lapang seketika.", s: "Nasihat Ulama" },
                    { k: "Jangan biarkan kata-kata kasar keluar dari lisanmu, sebab ia tak bisa ditarik kembali.", s: "Nasihat" },
                    { k: "Jadikan amarahmu sebagai energi untuk memperbaiki diri, bukan merusak keadaan.", s: "Nasihat Bijak" },
