---
import MainLayout from '../layouts/MainLayout.astro';

// 1. KUMPULAN 50 MOTIVASI
const motivasiList = [
    { kutipan: "Hati yang tenang adalah awal dari ibadah yang khusyuk.", sumber: "Bilik Tafakur" },
    { kutipan: "Maka sesungguhnya bersama kesulitan ada kemudahan.", sumber: "Al-Qur'an (QS. Al-Insyirah: 5)" },
    { kutipan: "Dunia ini bagaikan bayangan. Jika kau berusaha menangkapnya, ia akan lari. Tapi jika kau membelakanginya, ia tak punya pilihan selain mengikutimu.", sumber: "Ibnu Qayyim Al-Jauziyyah" },
    { kutipan: "Apapun yang menjadi takdirmu, akan mencari jalannya menemukanmu.", sumber: "Ali bin Abi Thalib" },
    { kutipan: "Jangan bersedih, sesungguhnya Allah bersama kita.", sumber: "Al-Qur'an (QS. At-Taubah: 40)" },
    { kutipan: "Menangislah karena dosa-dosamu, dan bersyukurlah atas nikmat Tuhanmu.", sumber: "Nasihat Bijak" },
    { kutipan: "Kekayaan hakiki bukan pada banyaknya harta, melainkan pada hati yang selalu merasa cukup.", sumber: "Hadits (HR. Bukhari & Muslim)" },
    { kutipan: "Ilmu tanpa amal bagaikan pohon yang tidak berbuah.", sumber: "Pepatah Arab (Syauqi Beik)" },
    { kutipan: "Sabar itu pahit, tapi buahnya lebih manis dari madu.", sumber: "Luqman Al-Hakim" },
    { kutipan: "Waktu bagaikan pedang, jika kau tidak memotongnya (menggunakannya), maka ia yang akan memotongmu.", sumber: "Imam Syafi'i" },
    // 11-20
    { kutipan: "Barangsiapa memperbaiki hubungannya dengan Allah, maka Allah akan memperbaiki hubungannya dengan manusia.", sumber: "Sufyan bin Uyainah" },
    { kutipan: "Doa adalah senjata bagi orang mukmin dan tiang bagi agama.", sumber: "Hadits (HR. Al-Hakim)" },
    { kutipan: "Lebih baik diam daripada bicara yang tidak membawa manfaat atau justru menyakiti.", sumber: "Nasihat Imam Al-Ghazali" },
    { kutipan: "Kejujuran adalah perhiasan bagi jiwa dan ketenangan bagi hati.", sumber: "Ali bin Abi Thalib" },
    { kutipan: "Dunia adalah ladang untuk tempat bercocok tanam yang hasilnya akan dipanen di akhirat.", sumber: "Atsar Sahabat" },
    { kutipan: "Janganlah kamu meremehkan kebaikan sekecil apa pun, bahkan sekadar menyambut saudaramu dengan wajah ceria.", sumber: "Hadits (HR. Muslim)" },
    { kutipan: "Syukur adalah pengikat nikmat yang sudah ada dan pemancing nikmat yang belum datang.", sumber: "Umar bin Khattab" },
    { kutipan: "Cukuplah kematian sebagai pemberi nasihat.", sumber: "Hadits (HR. Ath-Thabrani)" },
    { kutipan: "Ridha Allah terletak pada ridha kedua orang tua, dan murka Allah terletak pada kemurkaan kedua orang tua.", sumber: "Hadits (HR. Tirmidzi)" },
    { kutipan: "Mencintai Allah adalah puncak segala cinta, dan mengenal-Nya adalah puncak segala ilmu.", sumber: "Rabi'ah Al-Adawiyah" },
    // 21-30
    { kutipan: "Lidahmu janganlah kau biarkan menyebut kekurangan orang lain, sebab kau pun punya kekurangan dan orang lain pun punya lidah.", sumber: "Imam Syafi'i" },
    { kutipan: "Ikhlas adalah rahasia antara Allah dan hamba-Nya, bahkan malaikat pun tak tahu untuk mencatatnya.", sumber: "Junaid Al-Baghdadi" },
    { kutipan: "Kesulitan itu mendewasakan jiwa, sementara kemudahan seringkali menguji kesetiaan hati.", sumber: "Bilik Tafakur" },
    { kutipan: "Barangsiapa yang memperbanyak istighfar, maka Allah akan memberikan jalan keluar dari setiap kesempitannya.", sumber: "Hadits (HR. Abu Dawud)" },
    { kutipan: "Jadikanlah sholat sebagai tempat peristirahatanmu dan penyejuk hatimu.", sumber: "Hadits (HR. Ahmad)" },
    { kutipan: "Tawakkal adalah menyerahkan segala urusan kepada Allah setelah usaha maksimal dilakukan.", sumber: "Imam Al-Ghazali" },
    { kutipan: "Puncak dari ilmu adalah rasa takut (tazim) kepada Allah SWT.", sumber: "Abdullah bin Mas'ud" },
    { kutipan: "Dunia ini hanya tiga hari: Kemarin yang takkan kembali, esok yang belum tentu kau temui, dan hari ini untuk kau berbakti.", sumber: "Hasan Al-Bashri" },
    { kutipan: "Hiduplah di dunia ini seakan-akan kamu adalah orang asing atau pengembara.", sumber: "Hadits (HR. Bukhari)" },
    { kutipan: "Seorang mukmin dengan mukmin lainnya bagaikan satu bangunan yang saling menguatkan.", sumber: "Hadits (HR. Bukhari & Muslim)" },
    // 31-40
    { kutipan: "Kemuliaan ada pada ketaatan, dan kehinaan ada pada kemaksiatan.", sumber: "Abdullah bin Mubarak" },
    { kutipan: "Hati yang bersih akan melihat kebenaran dengan cahaya Tuhan, meski di tengah kegelapan dunia.", sumber: "Bilik Tafakur" },
    { kutipan: "Kesabaran adalah cahaya yang menerangi jalan dalam kegelapan ujian.", sumber: "Hadits (HR. Muslim)" },
    { kutipan: "Jangan menunggu tua untuk bertaubat, sebab kematian tidak menunggu tua untuk menjemput.", sumber: "Nasihat Ulama" },
    { kutipan: "Sedekah tidak akan mengurangi harta, justru ia akan memberkahi dan menambahnya.", sumber: "Hadits (HR. Muslim)" },
    { kutipan: "Ingatlah, hanya dengan mengingat Allah hati menjadi tenteram.", sumber: "Al-Qur'an (QS. Ar-Ra'd: 28)" },
    { kutipan: "Barangsiapa mengenal dirinya, maka ia akan mengenal Tuhannya.", sumber: "Pepatah Sufi" },
    { kutipan: "Ada dua mata yang tidak akan disentuh api neraka: mata yang menangis karena takut kepada Allah, dan mata yang berjaga di jalan Allah.", sumber: "Hadits (HR. Tirmidzi)" },
    { kutipan: "Adab adalah warisan yang paling utama bagi anak cucu.", sumber: "Ali bin Abi Thalib" },
    { kutipan: "Senyummu di depan saudaramu adalah sedekah.", sumber: "Hadits (HR. Tirmidzi)" },
    // 41-50
    { kutipan: "Dunia ini adalah penjara bagi orang mukmin dan surga bagi orang kafir.", sumber: "Hadits (HR. Muslim)" },
    { kutipan: "Sebaik-baik manusia adalah yang paling bermanfaat bagi manusia lainnya.", sumber: "Hadits (HR. Ath-Thabrani)" },
    { kutipan: "Cukuplah Allah sebagai penolong kami, dan Allah adalah sebaik-baik pelindung.", sumber: "Al-Qur'an (QS. Ali Imran: 173)" },
    { kutipan: "Ketenangan batin adalah rezeki yang tak ternilai, yang hanya diberikan kepada hati yang bersyukur.", sumber: "Bilik Tafakur" },
    { kutipan: "Jangan biarkan hari ini berlalu tanpa tadabbur, sebab setiap detik adalah pelajaran.", sumber: "Nasihat" },
    { kutipan: "Setiap langkah kaki menuju masjid (untuk sholat) dicatat sebagai satu kebaikan.", sumber: "Hadits (HR. Muslim)" },
    { kutipan: "Jagalah Allah, niscaya Allah akan menjagamu.", sumber: "Hadits (HR. Tirmidzi)" },
    { kutipan: "Iri hati memakan kebaikan sebagaimana api memakan kayu bakar.", sumber: "Hadits (HR. Abu Dawud)" },
    { kutipan: "Dunia hanyalah titipan, maka jangan terlalu menggenggamnya seolah ia milikmu selamanya.", sumber: "Nasihat" },
    { kutipan: "Semoga hari ini kita menjadi pribadi yang lebih baik dari hari kemarin.", sumber: "Doa & Harapan" }
];

// 2. LOGIKA PENJADWALAN 
const startDate = new Date('2026-04-05'); 
const today = new Date();
const diffInDays = Math.floor((today.getTime() - startDate.getTime()) / (1000 * 3600 * 24));
const visibleCount = Math.min(motivasiList.length, 10 + (diffInDays * 10));
const visibleMotivasi = motivasiList.slice(0, visibleCount);
---

<MainLayout title="Motivasi">
    <div class="mb-16 text-center max-w-3xl mx-auto">
        <h1 class="text-3xl md:text-4xl font-serif font-bold text-slate-900 dark:text-white mb-4">Ruang Renungan</h1>
        <p class="text-slate-600 dark:text-slate-400">
            Untaian hikmah penyejuk batin yang akan terbuka secara bertahap.
        </p>
    </div>

    <div class="flex flex-col gap-12 max-w-3xl mx-auto pb-16 px-4">
        {visibleMotivasi.map((item) => {
            const linkWeb = "https://bilik-tafakur.vercel.app/motivasi"; 
            const textWA = `_"${item.kutipan}"_\n\n— *${item.sumber}*\n\n🌿 Dibagikan dari Bilik Tafakur\nBuka di sini: ${linkWeb}`;
            const linkWA = `https://wa.me/?text=${encodeURIComponent(textWA)}`;
            
            return (
            <div class="relative p-10 md:p-14 bg-gradient-to-b from-white to-slate-50 dark:from-slate-900 dark:to-slate-800/80 rounded-[2rem] border border-slate-100 dark:border-slate-700 shadow-[0_8px_30px_rgb(0,0,0,0.04)] dark:shadow-[0_8px_30px_rgb(0,0,0,0.2)] group overflow-hidden">
                
                <div class="absolute -top-10 -right-4 text-[12rem] opacity-[0.03] dark:opacity-[0.05] text-slate-900 dark:text-white font-serif rotate-12 select-none pointer-events-none">"</div>
                
                <div class="absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-emerald-500 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>

                <div class="relative z-10 flex flex-col items-center text-center">
                    
                    <p class="text-2xl md:text-[1.75rem] font-serif text-slate-800 dark:text-slate-100 leading-snug font-medium mb-10 italic">
                        "{item.kutipan}"
                    </p>
                    
                    <div class="flex items-center gap-4 mb-10 w-full max-w-md">
                        <div class="flex-1 h-[1px] bg-slate-200 dark:bg-slate-700"></div>
                        <p class="text-xs md:text-sm font-semibold text-emerald-700 dark:text-emerald-400 tracking-[0.2em] uppercase shrink-0">
                            {item.sumber}
                        </p>
                        <div class="flex-1 h-[1px] bg-slate-200 dark:bg-slate-700"></div>
                    </div>

                    <a 
                        href={linkWA} 
                        target="_blank" 
                        rel="noopener noreferrer"
                        title="Bagikan ke WhatsApp"
                        class="inline-flex items-center gap-2.5 px-6 py-3 bg-slate-900 dark:bg-emerald-600 text-white text-xs font-bold rounded-full hover:bg-emerald-600 dark:hover:bg-emerald-500 hover:scale-105 transition-all duration-300 shadow-md hover:shadow-lg"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                        </svg>
                        Bagikan Nasihat
                    </a>
                </div>

            </div>
            );
        })}
    </div>
</MainLayout>