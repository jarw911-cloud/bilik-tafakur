---
import MainLayout from '../../layouts/MainLayout.astro';
import { daftarMotivasi } from '../../data/motivasi.js';
---

<MainLayout title="Motivasi & Tafakur - Bilik Tafakur">
    <div class="max-w-6xl mx-auto py-12 px-8 md:px-12 lg:px-16 animate-fade-in">
        
        <div class="mb-12 border-b border-slate-200 dark:border-slate-800 pb-8 text-center md:text-left">
            <h1 class="text-3xl md:text-5xl font-poppins font-bold text-emerald-900 dark:text-emerald-400 mb-4 tracking-tight">
               ✨ Motivasi & Tafakur
            </h1>
            <p class="text-slate-600 dark:text-slate-400 text-lg leading-relaxed font-jakarta">
                Renungan Nalar Teras kagem njaga ketenangan batin lan kakuwatan mental.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {daftarMotivasi.map((item) => (
                <a href={`/motivasi/${item.slug}`} class="group relative p-8 bg-white dark:bg-slate-900 rounded-[2.5rem] border border-slate-200 dark:border-slate-800 hover:border-emerald-500 hover:shadow-2xl transition-all duration-500 overflow-hidden">
                    <div class="absolute -right-4 -top-4 text-7xl opacity-10 group-hover:scale-125 transition-transform">
                        {item.icon}
                    </div>
                    
                    <div class="relative z-10">
                        <div class="flex items-center gap-3 mb-4">
                            <span class="text-[10px] uppercase tracking-widest text-emerald-600 font-bold px-3 py-1 bg-emerald-50 dark:bg-emerald-900/30 rounded-full">
                                {item.kategori}
                            </span>
                            <span class="text-xs text-slate-400">{item.tanggal}</span>
                        </div>

                        <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100 group-hover:text-emerald-600 transition-colors mb-4 leading-tight">
                            {item.judul}
                        </h2>

                        <p class="text-slate-500 dark:text-slate-400 italic border-l-2 border-emerald-200 pl-4 mb-6 line-clamp-3">
                            "{item.kutipan}"
                        </p>

                        <div class="flex items-center gap-2 text-xs font-bold text-emerald-700 dark:text-emerald-400">
                            Selengkapnya <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                        </div>
                    </div>
                </a>
            ))}
        </div>
    </div>
</MainLayout>